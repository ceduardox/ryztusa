

<div
  class="blog-post-content rte"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--normal-content-width);
    margin: 0 auto;
    color: var(--color, inherit);
  }

  .blog-post-content a {
    color: #6426ff;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .blog-post-content rte-formatter { line-height: 1.72; }
  .blog-post-content h2 { margin-top: 2.2em; margin-bottom: .65em; line-height: 1.14; }
  .blog-post-content p + p { margin-top: 1.15em; }
  .blog-post-content li + li { margin-top: .45em; }

  @media screen and (max-width: 749px) {
    .blog-post-content rte-formatter { line-height: 1.65; }
    .blog-post-content h2 { margin-top: 1.8em; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "t:names.content",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
