

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}

    {%- comment -%} RYZTOR: enlaces a páginas y políticas (siempre visibles, bilingüe) {%- endcomment -%}
    {%- liquid
      assign lang = request.locale.iso_code | downcase
      if lang == 'es'
        assign t_shop = 'Tienda'
        assign t_policies = 'Políticas'
        assign t_legal = 'Legal'
        assign t_help = 'Ayuda'
        assign t_home = 'Inicio'
        assign t_catalog = 'Catálogo'
        assign t_contact = 'Contacto'
        assign t_refund = 'Reembolsos y devoluciones'
        assign t_shipping = 'Política de envío'
        assign t_terms = 'Términos y condiciones'
        assign t_privacy = 'Política de privacidad'
        assign t_disclaimer = 'Aviso legal'
        assign t_privacy_opts = 'Tus opciones de privacidad'
        assign t_faq = 'Preguntas frecuentes'
      else
        assign t_shop = 'Shop'
        assign t_policies = 'Policies'
        assign t_legal = 'Legal'
        assign t_help = 'Help'
        assign t_home = 'Home'
        assign t_catalog = 'Catalog'
        assign t_contact = 'Contact'
        assign t_refund = 'Refund & Return Policy'
        assign t_shipping = 'Shipping Policy'
        assign t_terms = 'Terms and Conditions'
        assign t_privacy = 'Privacy Policy'
        assign t_disclaimer = 'Legal Disclaimer'
        assign t_privacy_opts = 'Your privacy options'
        assign t_faq = 'FAQ'
      endif
    -%}
    <style>
      .ryz-footer-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:32px;text-align:left;padding:30px 0 14px;margin-top:10px;font-family:var(--font-body--family);}
      .ryz-footer-links .ryz-col{position:relative;}
      .ryz-footer-links .ryz-col h4{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:var(--color-foreground, #111);opacity:.5;margin:0 0 16px;}
      .ryz-footer-links .ryz-col h4::after{content:"";display:block;width:22px;height:1.5px;background:var(--color-foreground, #111);opacity:.3;margin-top:8px;transition:width .35s ease;}
      .ryz-footer-links .ryz-col:hover h4::after{width:100%;}
      .ryz-footer-links .ryz-col ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;}
      .ryz-footer-links .ryz-col a{font-size:13.5px;line-height:1.4;color:var(--color-foreground, #111);opacity:.72;text-decoration:none;position:relative;display:inline-block;transition:opacity .25s ease, transform .3s ease;background-image:linear-gradient(currentColor,currentColor);background-size:0% 1.5px;background-repeat:no-repeat;background-position:left bottom;}
      .ryz-footer-links .ryz-col a:hover{opacity:1;transform:translateX(4px);background-size:100% 1.5px;}
      @media(max-width:640px){.ryz-footer-links{grid-template-columns:1fr 1fr;gap:26px 18px;}}
    </style>
    <div class="ryz-footer-links">
      <div class="ryz-col">
        <h4>{{ t_shop }}</h4>
        <ul>
          <li><a href="/">{{ t_home }}</a></li>
          <li><a href="/collections/all">{{ t_catalog }}</a></li>
          <li><a href="/pages/contact">{{ t_contact }}</a></li>
        </ul>
      </div>
      <div class="ryz-col">
        <h4>{{ t_policies }}</h4>
        <ul>
          <li><a href="/pages/refund-return-policy">{{ t_refund }}</a></li>
          <li><a href="/pages/shipping-policy">{{ t_shipping }}</a></li>
          <li><a href="/pages/terms-and-conditions">{{ t_terms }}</a></li>
          <li><a href="/pages/privacy-policy">{{ t_privacy }}</a></li>
        </ul>
      </div>
      <div class="ryz-col">
        <h4>{{ t_legal }}</h4>
        <ul>
          <li><a href="/pages/legal-disclaimer">{{ t_disclaimer }}</a></li>
          <li><a href="/pages/tus-opciones-de-privacidad">{{ t_privacy_opts }}</a></li>
        </ul>
      </div>
      <div class="ryz-col">
        <h4>{{ t_help }}</h4>
        <ul>
          <li><a href="/pages/frequently-asked-questions-faq">{{ t_faq }}</a></li>
        </ul>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "ryztor-footer-links"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
