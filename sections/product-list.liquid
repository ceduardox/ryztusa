

{% liquid
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    {% if section.settings.ryztor_showcase_style %}section-resource-list--ryztor-showcase{% endif %}
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'collection'
            %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .section-resource-list--ryztor-showcase {
    position: relative;
  }

  .section-resource-list--ryztor-showcase .section-resource-list__header {
    padding-bottom: clamp(8px, 1.5vw, 18px);
    border-bottom: 1px solid rgb(100 38 255 / 14%);
  }

  .section-resource-list--ryztor-showcase .section-resource-list__header h2 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.8rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .section-resource-list--ryztor-showcase .section-resource-list__header h2::after {
    content: '.';
    color: #6426ff;
  }

  .section-resource-list--ryztor-showcase .section-resource-list__header .button,
  .section-resource-list--ryztor-showcase .section-resource-list__header a {
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-underline-offset: 5px;
  }

  .section-resource-list--ryztor-showcase .resource-list__item {
    min-width: 0;
  }

  .section-resource-list--ryztor-showcase product-card {
    border: 1px solid rgb(100 38 255 / 13%);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 10px 30px rgb(48 24 95 / 8%);
    height: auto;
    min-height: 100%;
    overflow: visible;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .section-resource-list--ryztor-showcase .product-card__content {
    height: auto;
    min-height: 100%;
    overflow: visible;
    padding: 10px 10px 16px;
    border-radius: inherit;
    background: #fff;
  }

  .section-resource-list--ryztor-showcase slideshow-component {
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(145deg, #f3efff 0%, #eefbdc 100%);
  }

  .section-resource-list--ryztor-showcase :is(.product-card__content h3, .product-card__content h4, .product-card__content [role='heading']) {
    margin-top: 6px;
    padding-inline: 10px;
    font-size: clamp(1.2rem, 1.65vw, 1.55rem);
    font-weight: 760;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-transform: none;
  }

  .section-resource-list--ryztor-showcase .product-card__content product-price,
  .section-resource-list--ryztor-showcase .product-card__content .price {
    padding-inline: 10px;
    color: #6426ff;
    font-weight: 800;
  }

  .section-resource-list--ryztor-showcase .product-card__content product-price {
    font-size: .96rem;
    letter-spacing: -0.02em;
  }

  .section-resource-list--ryztor-showcase .resource-list__item .product-card {
    height: auto;
    min-height: 100%;
  }

  @media (hover: hover) {
    .section-resource-list--ryztor-showcase product-card:hover {
      transform: translateY(-7px);
      border-color: rgb(100 38 255 / 34%);
      box-shadow: 0 20px 48px rgb(48 24 95 / 15%);
    }

    .section-resource-list--ryztor-showcase product-card:hover slideshow-component img {
      transform: scale(1.025);
    }

    .section-resource-list--ryztor-showcase slideshow-component img {
      transition: transform 350ms ease;
    }
  }

  @media screen and (max-width: 749px) {
    .section-resource-list--ryztor-showcase .section-resource-list__header > * {
      align-items: flex-start;
      gap: 10px;
    }

    .section-resource-list--ryztor-showcase product-card {
      border-radius: 22px;
      margin-bottom: 4px;
    }

    .section-resource-list--ryztor-showcase slideshow-component {
      border-radius: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
