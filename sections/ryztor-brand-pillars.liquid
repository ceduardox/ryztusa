<section
  class="ryztor-pillars"
  style="--rp-bg: {{ section.settings.background }}; --rp-text: {{ section.settings.text_color }}; --rp-accent: {{ section.settings.accent }}; --rp-purple: {{ section.settings.secondary }};"
>
  <div class="ryztor-pillars__inner">
    <div class="ryztor-pillars__visual">
      <div class="ryztor-pillars__product-stage" aria-label="Berberine, Magnesium Glycinate and Creatine">
        <span class="ryztor-pillars__orb ryztor-pillars__orb--one" aria-hidden="true"></span>
        <span class="ryztor-pillars__orb ryztor-pillars__orb--two" aria-hidden="true"></span>
        <div class="ryztor-pillars__product ryztor-pillars__product--berberine">
          <img src="{{ 'ryztor-pillars-berberine.webp' | asset_url }}" width="587" height="1050" loading="lazy" alt="RYZTOR Berberine">
          <div class="ryztor-pillars__product-label"><span>01</span><strong>{{ 'ryztor.home.pillars.item_1_moment' | t }}</strong></div>
        </div>
        <div class="ryztor-pillars__product ryztor-pillars__product--magnesium">
          <img src="{{ 'ryztor-pillars-magnesium.webp' | asset_url }}" width="531" height="1050" loading="lazy" alt="RYZTOR Magnesium Glycinate">
          <div class="ryztor-pillars__product-label"><span>02</span><strong>{{ 'ryztor.home.pillars.item_2_moment' | t }}</strong></div>
        </div>
        <div class="ryztor-pillars__product ryztor-pillars__product--creatine">
          <img src="{{ 'ryztor-pillars-creatine.webp' | asset_url }}" width="821" height="1050" loading="lazy" alt="RYZTOR Creatine Monohydrate">
          <div class="ryztor-pillars__product-label"><span>03</span><strong>{{ 'ryztor.home.pillars.item_3_moment' | t }}</strong></div>
        </div>
      </div>
    </div>

    <div class="ryztor-pillars__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ryztor-pillars__eyebrow">{{ 'ryztor.home.pillars.eyebrow' | t }}</p>
      {%- endif -%}
      <h2>{{ 'ryztor.home.pillars.heading_html' | t }}</h2>
      {%- if section.settings.description != blank -%}
        <div class="ryztor-pillars__intro rte"><p>{{ 'ryztor.home.pillars.description' | t }}</p></div>
      {%- endif -%}

      <div class="ryztor-pillars__list">
        {%- for block in section.blocks -%}
          {% liquid
            assign item_key = 'ryztor.home.pillars.item_' | append: forloop.index
            assign heading_key = item_key | append: '_heading'
            assign text_key = item_key | append: '_text'
          %}
          <article class="ryztor-pillars__item" {{ block.shopify_attributes }}>
            <span class="ryztor-pillars__number">0{{ forloop.index }}</span>
            <div>
              <h3>{{ heading_key | t }}</h3>
              <p>{{ text_key | t }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="ryztor-pillars__note">{{ 'ryztor.home.pillars.note' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ryztor-pillars { background: var(--rp-bg); color: var(--rp-text); }
  .ryztor-pillars__inner { width: min(100% - 32px, 1280px); margin: auto; display: grid; grid-template-columns: .92fr 1.08fr; align-items: center; gap: clamp(40px, 7vw, 100px); padding-block: clamp(72px, 9vw, 128px); }
  .ryztor-pillars__visual { min-height: clamp(520px, 55vw, 720px); overflow: hidden; display: grid; place-items: center; border: 2px solid #121212; border-radius: 32px; background: #f0ebff; box-shadow: -14px 14px 0 var(--rp-accent); }
  .ryztor-pillars__product-stage { position: relative; width: 100%; height: 100%; min-height: inherit; isolation: isolate; }
  .ryztor-pillars__orb { position: absolute; z-index: -1; display: block; border-radius: 50%; filter: blur(.1px); }
  .ryztor-pillars__orb--one { width: 62%; aspect-ratio: 1; top: -20%; right: -20%; background: var(--rp-accent); }
  .ryztor-pillars__orb--two { width: 76%; aspect-ratio: 1; bottom: -43%; left: -24%; background: var(--rp-purple); opacity: .95; }
  .ryztor-pillars__product { position: absolute; bottom: 7%; display: grid; grid-template-rows: 1fr auto; place-items: end center; padding: 22px 10px 14px; border: 1px solid rgb(18 18 18 / 16%); border-radius: 24px; background: rgb(255 255 255 / 76%); box-shadow: 0 18px 36px rgb(18 18 18 / 14%); backdrop-filter: blur(10px); transition: transform 240ms ease, box-shadow 240ms ease; }
  .ryztor-pillars__product img { width: 100%; height: 100%; min-height: 0; display: block; object-fit: contain; filter: drop-shadow(0 15px 11px rgb(18 18 18 / 18%)); }
  .ryztor-pillars__product-label { width: calc(100% - 8px); min-height: 54px; display: grid; grid-template-columns: 30px 1fr; align-items: center; gap: 8px; padding: 7px 9px; border-radius: 14px; background: #121212; color: white; }
  .ryztor-pillars__product-label span { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--rp-accent); color: #121212; font-size: .58rem; font-weight: 900; }
  .ryztor-pillars__product-label strong { font-size: clamp(.58rem, .72vw, .72rem); line-height: 1.15; letter-spacing: .04em; text-transform: uppercase; }
  .ryztor-pillars__product--berberine { z-index: 3; left: 4%; width: 31%; height: 64%; }
  .ryztor-pillars__product--magnesium { z-index: 2; left: 34.5%; width: 31%; height: 72%; bottom: 14%; }
  .ryztor-pillars__product--creatine { z-index: 4; right: 4%; width: 31%; height: 64%; }
  .ryztor-pillars__product:hover { z-index: 5; transform: translateY(-8px); box-shadow: 0 26px 48px rgb(18 18 18 / 22%); }
  .ryztor-pillars__eyebrow { width: fit-content; margin: 0 0 18px; padding: 8px 13px; border: 1px solid currentColor; border-radius: 999px; font-size: .72rem; font-weight: 800; letter-spacing: .12em; }
  .ryztor-pillars__content > h2 { max-width: 10ch; margin: 0; color: inherit; font-size: clamp(3rem, 6vw, 6rem); line-height: .92; letter-spacing: -.055em; text-transform: uppercase; }
  .ryztor-pillars__content > h2 em { color: var(--rp-purple); font-style: italic; font-weight: inherit; }
  .ryztor-pillars__intro { max-width: 650px; margin-top: 24px; font-size: clamp(1rem, 1.25vw, 1.18rem); line-height: 1.55; }
  .ryztor-pillars__list { display: grid; gap: 12px; margin-top: 32px; }
  .ryztor-pillars__item { display: grid; grid-template-columns: 48px 1fr; gap: 16px; padding: 20px; border: 1px solid rgb(18 18 18 / 20%); border-radius: 18px; background: white; transition: transform 180ms ease, box-shadow 180ms ease; }
  .ryztor-pillars__item:hover { transform: translateX(5px); box-shadow: -6px 6px 0 rgb(100 38 255 / 18%); }
  .ryztor-pillars__number { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; background: var(--rp-accent); color: #121212; font-size: .72rem; font-weight: 900; }
  .ryztor-pillars__item h3 { margin: 0; color: inherit; font-size: 1rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
  .ryztor-pillars__item p { margin: 7px 0 0; color: rgb(18 18 18 / 72%); font-size: .9rem; line-height: 1.5; }
  .ryztor-pillars__note { margin: 22px 0 0; font-size: .72rem; line-height: 1.5; opacity: .72; }
  @media screen and (max-width: 899px) { .ryztor-pillars__inner { grid-template-columns: 1fr; } .ryztor-pillars__visual { min-height: 480px; order: 2; } .ryztor-pillars__content { order: 1; } }
  @media screen and (max-width: 749px) { .ryztor-pillars__inner { width: min(100% - 24px, 1280px); gap: 38px; } .ryztor-pillars__content > h2 { font-size: clamp(3rem, 15vw, 4.6rem); } .ryztor-pillars__visual { min-height: 430px; border-radius: 22px; box-shadow: -8px 8px 0 var(--rp-accent); } .ryztor-pillars__product { bottom: 7%; width: 31%; height: 66%; padding: 12px 5px 7px; border-radius: 15px; } .ryztor-pillars__product--berberine { left: 3%; } .ryztor-pillars__product--magnesium { left: 34.5%; height: 73%; bottom: 13%; } .ryztor-pillars__product--creatine { right: 3%; } .ryztor-pillars__product-label { min-height: 38px; grid-template-columns: 21px 1fr; gap: 4px; padding: 4px; border-radius: 9px; } .ryztor-pillars__product-label span { width: 20px; height: 20px; font-size: .48rem; } .ryztor-pillars__product-label strong { font-size: clamp(.44rem, 2vw, .58rem); } .ryztor-pillars__item { grid-template-columns: 42px 1fr; padding: 17px; } }
  @media (prefers-reduced-motion: reduce) { .ryztor-pillars__product { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "RYZTOR brand pillars",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY RYZTOR" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "THREE FORMULAS. ONE <em>BETTER</em> ROUTINE." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>RYZTOR is for people who want clear choices and supplements that fit real life. Pick one focused formula or build a routine around your goals.</p>" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle or product image" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Always review the product label and follow its directions for use." },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f6ff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#e4fe39" },
    { "type": "color", "id": "secondary", "label": "Secondary accent", "default": "#6426ff" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Product pillar",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Focused formula" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A clear, routine-friendly product for an everyday wellness goal." }
      ]
    }
  ],
  "presets": [
    {
      "name": "RYZTOR brand pillars",
      "blocks": [
        { "type": "pillar", "settings": { "heading": "Berberine, made simple", "text": "A focused Berberine formula designed to make daily supplementation straightforward." } },
        { "type": "pillar", "settings": { "heading": "Magnesium Glycinate, made simple", "text": "A focused Magnesium Glycinate formula designed to fit easily into your evening routine." } },
        { "type": "pillar", "settings": { "heading": "Creatine without the clutter", "text": "A familiar training essential presented in a clear, easy-to-follow format." } }
      ]
    }
  ]
}
{% endschema %}
