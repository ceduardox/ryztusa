  assign review_tags = 'ryztor.reviews.tags' | t | split: ','
  assign stars_template = 'ryztor.reviews.stars' | t: rating: '__RATING__'
  assign page_label_template = 'ryztor.reviews.go_to_page' | t: page: '__PAGE__'
  assign page_status_template = 'ryztor.reviews.showing' | t: start: '__START__', end: '__END__', total: '__TOTAL__'
%}

{% if is_berberine or is_magnesium %}
  <section
    class="ryztor-reviews"
    id="ryztor-reviews-{{ section.id }}"
    data-ryztor-reviews
    data-stars-template="{{ stars_template | escape }}"
    data-page-label-template="{{ page_label_template | escape }}"
    data-page-status-template="{{ page_status_template | escape }}"
    style="--reviews-accent: {{ section.settings.accent }}; --reviews-background: {{ section.settings.background }};"
  >
    <div class="ryztor-reviews__inner" id="ryztor-reviews">
      <header class="ryztor-reviews__heading">
        <p class="ryztor-reviews__eyebrow">{{ 'ryztor.reviews.eyebrow' | t }}</p>
        <h2>{{ 'ryztor.reviews.heading' | t }}</h2>
        <p class="ryztor-reviews__intro">{{ 'ryztor.reviews.text' | t }}</p>
        {% if request.locale.iso_code == 'es' %}<small class="ryztor-reviews__translation-note">{{ 'ryztor.reviews.translated_note' | t }}</small>{% endif %}
      </header>

      <div class="ryztor-reviews__overview">
        <div class="ryztor-reviews__score">
          <div class="ryztor-reviews__score-head">
            <strong>4.9</strong>
            <span class="ryztor-reviews__stars" aria-label="{{ 'ryztor.reviews.stars' | t: rating: '4.9' | escape }}">★★★★★</span>
            <span>{{ 'ryztor.reviews.review_count' | t: count: 186 }}</span>
          </div>

          <div class="ryztor-reviews__breakdown" aria-label="{{ 'ryztor.reviews.distribution' | t | escape }}">
            <div><b>5 <span>★</span></b><i><em style="width: 93.55%"></em></i><small>174</small></div>
            <div><b>4 <span>★</span></b><i><em style="width: 4.84%"></em></i><small>9</small></div>
            <div><b>3 <span>★</span></b><i><em style="width: 1.08%"></em></i><small>2</small></div>
            <div><b>2 <span>★</span></b><i><em style="width: .54%"></em></i><small>1</small></div>
            <div><b>1 <span>★</span></b><i><em style="width: 0%"></em></i><small>0</small></div>
          </div>
        </div>

        <div class="ryztor-reviews__photo-loop" aria-label="{{ 'ryztor.reviews.photos' | t | escape }}">
          <div class="ryztor-reviews__photo-track">
            <div class="ryztor-reviews__photo-group">
              {% for review_data in review_items %}
                {% assign review = review_data | split: '|' %}
                {% unless review[2] == 'none' %}
                  <button
                    type="button"
                    class="ryztor-reviews__loop-photo"
                    data-review-photo
                    data-full-image="{{ review[2] | asset_url }}"
                    data-image-alt="{{ review[3] | escape }}"
                    aria-label="{{ 'ryztor.reviews.enlarge' | t: description: review[3] | escape }}"
                  >
                    <img src="{{ review[2] | asset_url }}" alt="{{ review[3] | escape }}" width="112" height="132" loading="lazy">
                  </button>
                {% endunless %}
              {% endfor %}
            </div>
            <div class="ryztor-reviews__photo-group" aria-hidden="true">
              {% for review_data in review_items %}
                {% assign review = review_data | split: '|' %}
                {% unless review[2] == 'none' %}
                  <span class="ryztor-reviews__loop-photo">
                    <img src="{{ review[2] | asset_url }}" alt="" width="112" height="132" loading="lazy">
                  </span>
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="ryztor-reviews__tags" aria-label="{{ 'ryztor.reviews.topics' | t | escape }}">
        {% for tag in review_tags %}
          <span>{{ tag | escape }}</span>
        {% endfor %}
      </div>

      <div class="ryztor-reviews__verified-note">
        <span>{{ 'ryztor.reviews.customer_reviews' | t }}</span>
        <strong><i aria-hidden="true">✓</i> {{ 'ryztor.reviews.verified_buyers' | t }}</strong>
      </div>

      <div class="ryztor-reviews__list">
        {% for review_data in review_items %}
          {% assign review = review_data | split: '|' %}
          {% assign review_rating = review[1] | plus: 0 %}
          <article class="ryztor-reviews__item{% if review[2] == 'none' %} ryztor-reviews__item--text-only{% endif %}" data-review-row>
            <div class="ryztor-reviews__item-copy">
              <time datetime="{{ review[0] }}">{{ review[0] }}</time>
              <div class="ryztor-reviews__item-stars" aria-label="{{ 'ryztor.reviews.stars' | t: rating: review[1] | escape }}">
                {% for star_index in (1..5) %}{% if star_index <= review_rating %}★{% else %}☆{% endif %}{% endfor %}
              </div>
              <h3>
                {{ review[4] | escape }}
                <span aria-label="{{ 'ryztor.reviews.verified_buyer' | t | escape }}">✓</span>
              </h3>
              {% unless review[5] == 'stars-only' %}<p>{{ review[5] | escape }}</p>{% endunless %}
            </div>

            {% unless review[2] == 'none' %}
              <button
                type="button"
                class="ryztor-reviews__item-photo"
                data-review-photo
                data-full-image="{{ review[2] | asset_url }}"
                data-image-alt="{{ review[3] | escape }}"
                aria-label="{{ 'ryztor.reviews.enlarge' | t: description: review[3] | escape }}"
              >
                <img src="{{ review[2] | asset_url }}" alt="{{ review[3] | escape }}" width="118" height="142" loading="lazy">
                <span aria-hidden="true">+</span>
              </button>
            {% endunless %}
          </article>
        {% endfor %}
      </div>

      <nav class="ryztor-reviews__pagination" data-review-pagination aria-label="{{ 'ryztor.reviews.pages' | t | escape }}">
        <button type="button" data-review-previous aria-label="{{ 'ryztor.reviews.previous' | t | escape }}">←</button>
        <div data-review-pages></div>
        <button type="button" data-review-next aria-label="{{ 'ryztor.reviews.next' | t | escape }}">→</button>
        <p data-review-page-status aria-live="polite"></p>
      </nav>
    </div>

    <dialog class="ryztor-reviews__dialog" data-reviews-dialog aria-label="{{ 'ryztor.reviews.expanded' | t | escape }}">
      <button type="button" class="ryztor-reviews__close" data-reviews-close aria-label="{{ 'ryztor.reviews.close' | t | escape }}">×</button>
      <img
        data-reviews-dialog-image
        src="{{ dialog_image | asset_url }}"
        alt="{{ dialog_alt | escape }}"
        width="896"
        height="1200"
      >
    </dialog>
  </section>
{% endif %}

{% stylesheet %}
  .ryztor-reviews {
    padding: clamp(46px, 6vw, 86px) max(18px, calc((100vw - 1180px) / 2));
    background: var(--reviews-background);
    color: #17151e;
    overflow: hidden;
  }

  .ryztor-reviews__inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  .ryztor-reviews__heading {
    max-width: 700px;
    margin-bottom: 34px;
  }

  .ryztor-reviews__eyebrow {
    margin: 0 0 8px;
    color: var(--reviews-accent);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ryztor-reviews__heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.7rem);
    font-weight: 900;
    letter-spacing: -.05em;
    line-height: 1;
  }

  .ryztor-reviews__intro {
    margin: 14px 0 0;
    color: rgb(23 21 30 / 64%);
    line-height: 1.55;
  }

  .ryztor-reviews__translation-note {
    display: block;
    margin-top: 7px;
    color: rgb(23 21 30 / 48%);
    font-size: .72rem;
  }

  .ryztor-reviews__overview {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 62px);
  }

  .ryztor-reviews__score-head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 19px;
  }

  .ryztor-reviews__score-head strong {
    font-size: 1.2rem;
    font-weight: 900;
  }

  .ryztor-reviews__stars,
  .ryztor-reviews__item-stars {
    color: var(--reviews-accent);
    letter-spacing: .08em;
  }

  .ryztor-reviews__score-head > span:last-child {
    margin-left: auto;
    color: rgb(23 21 30 / 66%);
    font-size: .76rem;
  }

  .ryztor-reviews__breakdown {
    display: grid;
    gap: 8px;
  }

  .ryztor-reviews__breakdown > div {
    display: grid;
    grid-template-columns: 34px 1fr 24px;
    align-items: center;
    gap: 8px;
  }

  .ryztor-reviews__breakdown b {
    font-size: .76rem;
  }

  .ryztor-reviews__breakdown b span {
    color: #f6a800;
  }

  .ryztor-reviews__breakdown i {
    height: 10px;
    border-radius: 3px;
    background: #ebeaf0;
    overflow: hidden;
  }

  .ryztor-reviews__breakdown em {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, var(--reviews-accent) 48%, #cbc9d5);
  }

  .ryztor-reviews__breakdown small {
    color: rgb(23 21 30 / 58%);
    font-size: .66rem;
  }

  .ryztor-reviews__photo-loop {
    min-width: 0;
    padding-block: 4px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }

  .ryztor-reviews__photo-track {
    width: max-content;
    display: flex;
    animation: ryztor-review-loop 34s linear infinite;
  }

  .ryztor-reviews__photo-loop:hover .ryztor-reviews__photo-track {
    animation-play-state: paused;
  }

  .ryztor-reviews__photo-group {
    display: flex;
    gap: 9px;
    padding-right: 9px;
  }

  .ryztor-reviews__loop-photo {
    position: relative;
    flex: 0 0 112px;
    width: 112px;
    height: 132px;
    padding: 0;
    border: 0;
    border-radius: 9px;
    background: #eeecf2;
    cursor: zoom-in;
    overflow: hidden;
  }

  .ryztor-reviews__loop-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }

  button.ryztor-reviews__loop-photo:hover img {
    transform: scale(1.05);
  }

  @keyframes ryztor-review-loop {
    to { transform: translateX(-50%); }
  }

  .ryztor-reviews__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 34px 0 30px;
  }

  .ryztor-reviews__tags span {
    padding: 10px 14px;
    border-radius: 5px;
    background: #f7f6f9;
    color: #17151e;
    font-size: .76rem;
    font-weight: 850;
  }

  .ryztor-reviews__verified-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 0 15px;
    border-bottom: 1px solid rgb(23 21 30 / 12%);
    color: rgb(23 21 30 / 58%);
    font-size: .72rem;
  }

  .ryztor-reviews__verified-note strong {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #17151e;
  }

  .ryztor-reviews__verified-note i,
  .ryztor-reviews__item h3 span {
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: #20bf7a;
    color: #fff;
    font-style: normal;
  }

  .ryztor-reviews__verified-note i {
    width: 17px;
    height: 17px;
    font-size: .62rem;
  }

  .ryztor-reviews__list {
    max-width: 900px;
    margin: 0 auto;
  }

  .ryztor-reviews__item {
    min-height: 182px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 118px;
    gap: 34px;
    padding: 24px 0;
    border-bottom: 1px solid rgb(23 21 30 / 12%);
  }

  .ryztor-reviews__item[hidden] {
    display: none;
  }

  .ryztor-reviews__item--text-only {
    min-height: 122px;
    grid-template-columns: minmax(0, 1fr);
    padding-right: 152px;
  }

  .ryztor-reviews__item-copy time {
    display: block;
    margin-bottom: 12px;
    color: rgb(23 21 30 / 54%);
    font-size: .68rem;
  }

  .ryztor-reviews__item-stars {
    margin-bottom: 7px;
    font-size: .68rem;
  }

  .ryztor-reviews__item h3 {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 8px;
    font-size: .88rem;
    font-weight: 900;
  }

  .ryztor-reviews__item h3 span {
    width: 15px;
    height: 15px;
    font-size: .55rem;
  }

  .ryztor-reviews__item p {
    max-width: 650px;
    margin: 0;
    color: rgb(23 21 30 / 72%);
    font-size: .8rem;
    line-height: 1.55;
  }

  .ryztor-reviews__item-photo {
    position: relative;
    width: 118px;
    height: 142px;
    align-self: center;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: #eeecf2;
    cursor: zoom-in;
    overflow: hidden;
  }

  .ryztor-reviews__item-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }

  .ryztor-reviews__item-photo:hover img {
    transform: scale(1.05);
  }

  .ryztor-reviews__item-photo span {
    position: absolute;
    right: 7px;
    bottom: 7px;
    width: 25px;
    height: 25px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 92%);
    color: #17151e;
    font-size: 1rem;
    box-shadow: 0 4px 14px rgb(23 21 30 / 18%);
  }

  .ryztor-reviews__pagination {
    max-width: 900px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    margin: 28px auto 0;
  }

  .ryztor-reviews__pagination > button,
  .ryztor-reviews__pagination [data-review-pages] button {
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid rgb(23 21 30 / 12%);
    border-radius: 7px;
    background: #fff;
    color: #17151e;
    font: inherit;
    font-size: .76rem;
    font-weight: 850;
    cursor: pointer;
  }

  .ryztor-reviews__pagination > button:disabled {
    cursor: not-allowed;
    opacity: .35;
  }

  .ryztor-reviews__pagination [data-review-pages] {
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .ryztor-reviews__pagination [data-review-pages] button[aria-current="page"] {
    border-color: var(--reviews-accent);
    background: var(--reviews-accent);
    color: #fff;
  }

  .ryztor-reviews__pagination [data-review-pages] span {
    min-width: 24px;
    display: grid;
    place-items: center;
    color: rgb(23 21 30 / 48%);
  }

  .ryztor-reviews__pagination [data-review-page-status] {
    grid-column: 1 / -1;
    margin: 4px 0 0;
    color: rgb(23 21 30 / 54%);
    font-size: .68rem;
    text-align: center;
  }

  .ryztor-reviews__loop-photo:focus-visible,
  .ryztor-reviews__item-photo:focus-visible {
    outline: 3px solid var(--reviews-accent);
    outline-offset: 3px;
  }

  .ryztor-reviews__dialog {
    width: min(92vw, 760px);
    max-width: none;
    padding: 0;
    border: 0;
    border-radius: 22px;
    background: transparent;
    box-shadow: 0 30px 90px rgb(0 0 0 / 35%);
    overflow: visible;
  }

  .ryztor-reviews__dialog::backdrop {
    background: rgb(13 10 20 / 80%);
    backdrop-filter: blur(7px);
  }

  .ryztor-reviews__dialog img {
    display: block;
    width: 100%;
    max-height: 86vh;
    border-radius: 22px;
    background: #fff;
    object-fit: contain;
  }

  .ryztor-reviews__close {
    position: absolute;
    z-index: 2;
    top: -16px;
    right: -16px;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #17151e;
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  @media screen and (max-width: 849px) {
    .ryztor-reviews__overview {
      grid-template-columns: 1fr;
    }

    .ryztor-reviews__score {
      max-width: 360px;
    }

    .ryztor-reviews__photo-loop {
      margin-inline: -18px;
    }
  }

  @media screen and (max-width: 749px) {
    .ryztor-reviews {
      padding-block: 38px;
    }

    .ryztor-reviews__heading {
      margin-bottom: 28px;
    }

    .ryztor-reviews__loop-photo {
      flex-basis: 92px;
      width: 92px;
      height: 112px;
    }

    .ryztor-reviews__tags {
      flex-wrap: nowrap;
      margin-inline: -18px;
      padding-inline: 18px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .ryztor-reviews__tags::-webkit-scrollbar {
      display: none;
    }

    .ryztor-reviews__tags span {
      flex: 0 0 auto;
    }

    .ryztor-reviews__verified-note {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
    }

    .ryztor-reviews__item {
      min-height: 158px;
      grid-template-columns: minmax(0, 1fr) 88px;
      gap: 17px;
      padding: 20px 0;
    }

    .ryztor-reviews__item--text-only {
      min-height: 122px;
      grid-template-columns: minmax(0, 1fr);
      padding-right: 0;
    }

    .ryztor-reviews__item-photo {
      width: 88px;
      height: 108px;
    }

    .ryztor-reviews__close {
      top: 8px;
      right: 8px;
    }

    .ryztor-reviews__pagination {
      gap: 6px;
    }

    .ryztor-reviews__pagination > button,
    .ryztor-reviews__pagination [data-review-pages] button {
      min-width: 34px;
      height: 36px;
      padding-inline: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ryztor-reviews__photo-loop {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .ryztor-reviews__photo-track {
      animation: none;
    }

    .ryztor-reviews__photo-group[aria-hidden="true"] {
      display: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('ryztor-reviews-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const dialog = section.querySelector('[data-reviews-dialog]');
    const dialogImage = section.querySelector('[data-reviews-dialog-image]');
    const closeButton = section.querySelector('[data-reviews-close]');
    const reviewList = section.querySelector('.ryztor-reviews__list');
    const pagination = section.querySelector('[data-review-pagination]');
    const pageButtons = section.querySelector('[data-review-pages]');
    const previousButton = section.querySelector('[data-review-previous]');
    const nextButton = section.querySelector('[data-review-next]');
    const pageStatus = section.querySelector('[data-review-page-status]');
    const totalReviews = 186;
    const reviewsPerPage = 10;
    const totalPages = Math.ceil(totalReviews / reviewsPerPage);
    const starsTemplate = section.dataset.starsTemplate || '__RATING__ out of 5 stars';
    const pageLabelTemplate = section.dataset.pageLabelTemplate || 'Go to review page __PAGE__';
    const pageStatusTemplate = section.dataset.pageStatusTemplate || 'Showing __START__–__END__ of __TOTAL__ reviews';
    let currentPage = 1;

    const names = [
      'Madison R.', 'Abigail H.', 'Ella V.', 'Scarlett J.', 'Victoria P.', 'Aria C.',
      'Layla M.', 'Penelope S.', 'Riley D.', 'Nora G.', 'Lily B.', 'Eleanor T.',
      'Hazel W.', 'Aurora F.', 'Savannah K.', 'Audrey N.', 'Brooklyn A.', 'Bella L.',
      'Claire E.', 'Skylar O.', 'Lucy I.', 'Paisley Q.', 'Everly U.', 'Anna Z.'
    ];
    const comments = {% if request.locale.iso_code == 'es' %}[
      '', 'Bien', '', 'Bueno', 'Llegó rápido', '', 'Fácil de tomar', 'Buen producto',
      '', 'Bien empacado', 'Hasta ahora todo bien', '', 'Muy sencillo', 'Me gusta',
      '', 'Tal como se describe', 'Buena calidad', '', 'Llegó a tiempo', 'Gracias',
      '', 'Funciona bien en mi rutina', 'Sin problemas', '', 'Volvería a comprarlo', 'Contenta con el producto'
    ]{% else %}[
      '', 'Ok', '', 'Good', 'Came fast', '', 'Easy to take', 'Nice product',
      '', 'Well packed', 'So far so good', '', 'Very simple', 'I like it',
      '', 'Just as described', 'Good quality', '', 'arrived on time', 'Thank you',
      '', 'Works for my routine', 'No issues', '', 'would buy again', 'Happy with it'
    ]{% endif %};
    const fourStarIndexes = new Set([7, 19, 35, 52, 78, 99, 121, 149, 171]);
    const threeStarIndexes = new Set([63, 137]);
    const twoStarIndexes = new Set([112]);
    const sourceRows = Array.from(section.querySelectorAll('[data-review-row]'));

    const formatDate = (index) => {
      const date = new Date('2026-07-23T12:00:00');
      date.setDate(date.getDate() - Math.floor((index * 89) / (totalReviews - 1)));
      return date.toISOString().slice(0, 10);
    };

    const ratingFor = (index) => {
      if (twoStarIndexes.has(index)) return 2;
      if (threeStarIndexes.has(index)) return 3;
      if (fourStarIndexes.has(index)) return 4;
      return 5;
    };

    for (let index = sourceRows.length; index < totalReviews; index += 1) {
      const row = sourceRows[index % sourceRows.length].cloneNode(true);
      row.classList.add('ryztor-reviews__item--text-only');
      row.querySelector('.ryztor-reviews__item-photo')?.remove();
      reviewList.appendChild(row);
    }

    const allRows = Array.from(section.querySelectorAll('[data-review-row]'));
    allRows.forEach((row, index) => {
      const date = formatDate(index);
      const rating = ratingFor(index);
      const time = row.querySelector('time');
      const stars = row.querySelector('.ryztor-reviews__item-stars');
      const name = row.querySelector('h3');

      time.dateTime = date;
      time.textContent = date;
      stars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      stars.setAttribute('aria-label', starsTemplate.replace('__RATING__', rating));

      if (index >= sourceRows.length) {
        const verifiedBadge = name.querySelector('span');
        name.textContent = names[index % names.length];
        name.appendChild(verifiedBadge);

        row.querySelector('p')?.remove();
        const comment = comments[index % comments.length];
        if (comment) {
          const paragraph = document.createElement('p');
          paragraph.textContent = comment;
          row.querySelector('.ryztor-reviews__item-copy').appendChild(paragraph);
        }
      }
    });

    const visiblePageNumbers = () => {
      const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
      return Array.from(pages).filter((page) => page >= 1 && page <= totalPages).sort((a, b) => a - b);
    };

    const renderPageButtons = () => {
      pageButtons.innerHTML = '';
      let previousPageNumber = 0;

      visiblePageNumbers().forEach((pageNumber) => {
        if (previousPageNumber && pageNumber - previousPageNumber > 1) {
          const dots = document.createElement('span');
          dots.textContent = '…';
          pageButtons.appendChild(dots);
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = pageNumber;
        button.setAttribute('aria-label', pageLabelTemplate.replace('__PAGE__', pageNumber));
        if (pageNumber === currentPage) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => showPage(pageNumber, true));
        pageButtons.appendChild(button);
        previousPageNumber = pageNumber;
      });
    };

    const showPage = (page, shouldScroll = false) => {
      currentPage = Math.min(Math.max(page, 1), totalPages);
      const start = (currentPage - 1) * reviewsPerPage;
      const end = Math.min(start + reviewsPerPage, totalReviews);

      allRows.forEach((row, index) => {
        row.hidden = index < start || index >= end;
      });

      previousButton.disabled = currentPage === 1;
      nextButton.disabled = currentPage === totalPages;
      pageStatus.textContent = pageStatusTemplate
        .replace('__START__', start + 1)
        .replace('__END__', end)
        .replace('__TOTAL__', totalReviews);
      renderPageButtons();

      if (shouldScroll) {
        reviewList.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    previousButton.addEventListener('click', () => showPage(currentPage - 1, true));
    nextButton.addEventListener('click', () => showPage(currentPage + 1, true));
    showPage(1);

    section.querySelectorAll('[data-review-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        dialogImage.src = button.dataset.fullImage;
        dialogImage.alt = button.dataset.imageAlt;
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>

{% schema %}
{
  "name": "RYZTOR customer reviews",
  "tag": "section",
  "class": "ryztor-reviews-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section contains demo review copy for the unpublished theme. Replace it with real customer feedback before publishing."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real orders. Real feedback."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Short notes and everyday photos from the RYZTOR community."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#7652f5"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "RYZTOR customer reviews"
    }
  ]
}
{% endschema %}
