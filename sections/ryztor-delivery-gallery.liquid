      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real orders. Real feedback."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Short notes and everyday photos from the RYZTOR community."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#7652f5"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "RYZTOR customer reviews"
    }
  ]
}
{% endschema %}
