{
  "name": "RYZTOR customer reviews",
  "tag": "section",
  "class": "ryztor-reviews-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section contains demo review copy for the unpublished theme. Replace it with real customer feedback before publishing."
