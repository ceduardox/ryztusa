<section
  class="ryztor-hero"
  style="--hero-bg: {{ section.settings.background }}; --hero-text: {{ section.settings.text_color }}; --hero-accent: {{ section.settings.accent }}; --hero-secondary: {{ section.settings.secondary }};"
>
  <div class="ryztor-hero__inner">
    <div class="ryztor-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ryztor-hero__eyebrow">{{ 'ryztor.home.hero.eyebrow' | t }}</p>
      {%- endif -%}

      <h1 class="ryztor-hero__heading">{{ 'ryztor.home.hero.heading_html' | t }}</h1>

      {%- if section.settings.description != blank -%}
        <div class="ryztor-hero__description rte"><p>{{ 'ryztor.home.hero.description' | t }}</p></div>
      {%- endif -%}

      <div class="ryztor-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="ryztor-hero__button ryztor-hero__button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ 'ryztor.home.hero.primary' | t }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="ryztor-hero__button ryztor-hero__button--secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">
            {{ 'ryztor.home.hero.secondary' | t }}
          </a>
        {%- endif -%}
      </div>

      <ul class="ryztor-hero__proof" role="list">
        <li><span aria-hidden="true">✓</span>{{ 'ryztor.home.hero.proof_1' | t }}</li>
        <li><span aria-hidden="true">✓</span>{{ 'ryztor.home.hero.proof_2' | t }}</li>
        <li><span aria-hidden="true">✓</span>{{ 'ryztor.home.hero.proof_3' | t }}</li>
      </ul>
    </div>

    <div class="ryztor-hero__visual">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
              width="{{ section.settings.mobile_image.width }}"
              height="{{ section.settings.mobile_image.height }}"
            >
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              class: 'ryztor-hero__image',
              widths: '720, 1000, 1400, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        </picture>
      {%- else -%}
        <div class="ryztor-hero__orb ryztor-hero__orb--back"></div>
        <div class="ryztor-hero__orb ryztor-hero__orb--front"></div>
        <div class="ryztor-hero__brand-card">
          <span class="ryztor-hero__mark">R</span>
          <span class="ryztor-hero__brand-name">RYZTOR</span>
          <small>{{ 'ryztor.home.hero.brand_note' | t }}</small>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ryztor-hero {
    color: var(--hero-text);
    background:
      radial-gradient(circle at 15% 15%, rgb(255 255 255 / 75%), transparent 32%),
      var(--hero-bg);
    overflow: hidden;
  }

  .ryztor-hero__inner {
    width: min(100% - 32px, 1280px);
    min-height: clamp(600px, 74vh, 820px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 6vw, 90px);
    padding-block: clamp(64px, 8vw, 112px);
  }

  .ryztor-hero__content { position: relative; z-index: 2; }

  .ryztor-hero__eyebrow {
    width: fit-content;
    margin: 0 0 20px;
    padding: 8px 13px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .ryztor-hero__heading {
    max-width: 9.5ch;
    margin: 0;
    font-size: clamp(3.6rem, 7.4vw, 7.6rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .ryztor-hero__description {
    max-width: 560px;
    margin-top: 28px;
    font-size: clamp(1rem, 1.35vw, 1.25rem);
    line-height: 1.55;
  }

  .ryztor-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .ryztor-hero__button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border: 2px solid var(--hero-text);
    border-radius: 999px;
    color: inherit;
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .ryztor-hero__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 0 rgb(18 18 18 / 18%);
  }

  .ryztor-hero__button--primary {
    border-color: var(--hero-accent);
    background: var(--hero-accent);
    color: #121212;
  }

  .ryztor-hero__button--secondary { background: transparent; }

  .ryztor-hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .ryztor-hero__proof li { display: flex; align-items: center; gap: 7px; }
  .ryztor-hero__proof span { color: var(--hero-accent); font-size: 1rem; }

  .ryztor-hero__visual {
    position: relative;
    min-height: clamp(400px, 52vw, 690px);
    display: grid;
    place-items: center;
  }

  .ryztor-hero__visual picture,
  .ryztor-hero__image {
    width: 100%;
    height: 100%;
  }

  .ryztor-hero__image {
    display: block;
    object-fit: contain;
    border-radius: 32px;
  }

  .ryztor-hero__orb {
    position: absolute;
    width: min(36vw, 470px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--hero-accent);
    box-shadow: 0 0 70px rgb(228 254 57 / 60%);
  }

  .ryztor-hero__orb--back { transform: translate(10%, -12%); }
  .ryztor-hero__orb--front { transform: translate(-17%, 16%); opacity: 0.75; }

  .ryztor-hero__brand-card {
    position: relative;
    z-index: 1;
    width: min(62%, 360px);
    aspect-ratio: 0.78;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(24px, 4vw, 46px);
    border-radius: 30px;
    background: linear-gradient(145deg, #17151e, #472765);
    color: white;
    box-shadow: 0 28px 70px rgb(37 17 66 / 35%);
    transform: rotate(7deg);
  }

  .ryztor-hero__mark {
    position: absolute;
    top: 32px;
    right: 32px;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    background: var(--hero-secondary);
    color: white;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
  }

  .ryztor-hero__brand-name {
    color: var(--hero-accent);
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .ryztor-hero__brand-card small {
    margin-top: 13px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media screen and (max-width: 749px) {
    .ryztor-hero__inner {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 28px;
      padding-block: 48px 56px;
    }

    .ryztor-hero__heading {
      max-width: none;
      font-size: clamp(2.75rem, 13vw, 4.2rem);
      overflow-wrap: normal;
      word-break: normal;
    }
    .ryztor-hero__description { margin-top: 20px; }
    .ryztor-hero__actions { margin-top: 24px; }
    .ryztor-hero__button { width: 100%; }
    .ryztor-hero__proof { display: grid; gap: 8px; margin-top: 24px; }
    .ryztor-hero__visual { min-height: 390px; }
    .ryztor-hero__orb { width: min(78vw, 350px); }
    .ryztor-hero__brand-card { width: min(62vw, 280px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RYZTOR hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EVERYDAY WELLNESS, WITHOUT THE NOISE"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "BUILD YOUR <em>BETTER</em> ROUTINE."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully selected supplements designed to fit your everyday rhythm—from focused mornings to restful nights.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "SHOP SUPPLEMENTS"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "FIND YOUR ROUTINE"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "Highlight 1",
      "default": "Clear ingredients"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "Highlight 2",
      "default": "Simple routines"
    },
    {
      "type": "text",
      "id": "proof_3",
      "label": "Highlight 3",
      "default": "Everyday consistency"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f4f0ff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#e4fe39"
    },
    {
      "type": "color",
      "id": "secondary",
      "label": "Secondary accent",
      "default": "#6426ff"
    }
  ],
  "presets": [
    {
      "name": "RYZTOR hero"
    }
  ]
}
{% endschema %}
