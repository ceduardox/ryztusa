{% liquid
  assign product_title_normalized = product.title | downcase
  assign is_magnesium = false
  if product_title_normalized contains 'magnesium'
    assign is_magnesium = true
  endif

  assign review_count = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.quote != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
%}

{% if is_magnesium %}
  <section
    class="ryztor-berberine"
    style="--rb-accent: {{ section.settings.accent }}; --rb-ink: {{ section.settings.ink }}; --rb-soft: {{ section.settings.soft_background }}; --rb-card: {{ section.settings.card_background }};"
  >
    <div class="ryztor-berberine__trust" aria-label="{{ 'ryztor.magnesium.story.highlights' | t | escape }}">
      <div><span aria-hidden="true">✓</span> {{ 'ryztor.magnesium.story.supply' | t }}</div>
      <div><span aria-hidden="true">✓</span> {{ 'ryztor.magnesium.story.made_usa' | t }}</div>
      <div><span aria-hidden="true">✓</span> {{ 'ryztor.magnesium.story.daily_dose' | t }}</div>
      <div><span aria-hidden="true">✓</span> {{ 'ryztor.magnesium.story.preferences' | t }}</div>
    </div>

    <div class="ryztor-berberine__section ryztor-berberine__intro">
      <p class="ryztor-berberine__eyebrow">{{ 'ryztor.magnesium.story.eyebrow' | t }}</p>
      <h2>{{ 'ryztor.magnesium.story.heading' | t }}</h2>
      <div class="ryztor-berberine__lead rte"><p>{{ 'ryztor.magnesium.story.intro' | t }}</p></div>

      <div class="ryztor-berberine__benefit-orbit" data-benefit-orbit>
        <div class="ryztor-berberine__benefit-column ryztor-berberine__benefit-column--left">
          <article class="ryztor-berberine__benefit-callout">
            <span class="ryztor-berberine__benefit-plus" aria-hidden="true">+</span>
            <div>
              <h3>{{ 'ryztor.magnesium.story.benefit_1_title' | t }}</h3>
              <p>{{ 'ryztor.magnesium.story.benefit_1_text' | t }}</p>
            </div>
          </article>

          <article class="ryztor-berberine__benefit-callout">
            <span class="ryztor-berberine__benefit-plus" aria-hidden="true">+</span>
            <div>
              <h3>{{ 'ryztor.magnesium.story.benefit_2_title' | t }}</h3>
              <p>{{ 'ryztor.magnesium.story.benefit_2_text' | t }}</p>
            </div>
          </article>
        </div>

        <figure class="ryztor-berberine__capsule">
          <span class="ryztor-berberine__capsule-glow" aria-hidden="true"></span>
          <img
            src="{{ 'ryztor-magnesium-benefits.webp' | asset_url }}"
            alt="{{ 'ryztor.magnesium.story.image_alt' | t | escape }}"
            width="410"
            height="410"
            loading="lazy"
          >
          <figcaption>
            <strong>{{ 'ryztor.magnesium.story.formula_name' | t }}</strong>
            <span>{{ 'ryztor.magnesium.story.servings' | t }}</span>
          </figcaption>
        </figure>

        <div class="ryztor-berberine__benefit-column ryztor-berberine__benefit-column--right">
          <article class="ryztor-berberine__benefit-callout">
            <span class="ryztor-berberine__benefit-plus" aria-hidden="true">+</span>
            <div>
              <h3>{{ 'ryztor.magnesium.story.benefit_3_title' | t }}</h3>
              <p>{{ 'ryztor.magnesium.story.benefit_3_text' | t }}</p>
            </div>
          </article>

          <article class="ryztor-berberine__benefit-callout">
            <span class="ryztor-berberine__benefit-plus" aria-hidden="true">+</span>
            <div>
              <h3>{{ 'ryztor.magnesium.story.benefit_4_title' | t }}</h3>
              <p>{{ 'ryztor.magnesium.story.benefit_4_text' | t }}</p>
            </div>
          </article>
        </div>
      </div>
    </div>

    {% if request.locale.iso_code == 'es' %}
    <div class="ryztor-berberine__section ryztor-berberine__video">
      <header class="ryztor-berberine__section-heading">
        <p class="ryztor-berberine__eyebrow">{{ 'ryztor.magnesium.story.video_eyebrow' | t }}</p>
        <h2>{{ 'ryztor.magnesium.story.video_heading' | t }}</h2>
      </header>
      <div class="ryztor-berberine__video-grid ryztor-berberine__video-grid--two">
        <div class="ryztor-berberine__video-card">
          <div class="ryztor-berberine__video-player" data-video="MAGNESIUM-SPANISH-1">
            <img src="{{ 'MAGNESIUM-SPANISH-1-poster.jpg' | asset_url }}" alt="{{ 'ryztor.magnesium.story.video_1_alt' | t | escape }}" loading="lazy" width="360" height="640">
            <button class="ryztor-berberine__video-play" aria-label="{{ 'ryztor.magnesium.story.play_video' | t | escape }}">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <video preload="metadata" playsinline controls width="360" height="640" poster="{{ 'MAGNESIUM-SPANISH-1-poster.jpg' | asset_url }}">
              <source src="{{ 'MAGNESIUM-SPANISH-1.webm' | asset_url }}" type="video/webm">
            </video>
          </div>
          <p class="ryztor-berberine__video-label">{{ 'ryztor.magnesium.story.video_1' | t }}</p>
        </div>
        <div class="ryztor-berberine__video-card">
          <div class="ryztor-berberine__video-player" data-video="MAGNESIUM-SPANISH-2">
            <img src="{{ 'MAGNESIUM-SPANISH-2-poster.jpg' | asset_url }}" alt="{{ 'ryztor.magnesium.story.video_2_alt' | t | escape }}" loading="lazy" width="360" height="640">
            <button class="ryztor-berberine__video-play" aria-label="{{ 'ryztor.magnesium.story.play_video' | t | escape }}">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <video preload="metadata" playsinline controls width="360" height="640" poster="{{ 'MAGNESIUM-SPANISH-2-poster.jpg' | asset_url }}">
              <source src="{{ 'MAGNESIUM-SPANISH-2.webm' | asset_url }}" type="video/webm">
            </video>
          </div>
          <p class="ryztor-berberine__video-label">{{ 'ryztor.magnesium.story.video_2' | t }}</p>
        </div>
        <div class="ryztor-berberine__video-card">
          <div class="ryztor-berberine__video-player" data-video="MAGNESIUM-SPANISH-3">
            <img src="{{ 'MAGNESIUM-SPANISH-3-poster.jpg' | asset_url }}" alt="{{ 'ryztor.magnesium.story.video_3_alt' | t | escape }}" loading="lazy" width="360" height="640">
            <button class="ryztor-berberine__video-play" aria-label="{{ 'ryztor.magnesium.story.play_video' | t | escape }}">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <video preload="metadata" playsinline controls width="360" height="640" poster="{{ 'MAGNESIUM-SPANISH-3-poster.jpg' | asset_url }}">
              <source src="{{ 'MAGNESIUM-SPANISH-3.webm' | asset_url }}" type="video/webm">
            </video>
          </div>
          <p class="ryztor-berberine__video-label">{{ 'ryztor.magnesium.story.video_3' | t }}</p>
        </div>
        <div class="ryztor-berberine__video-card">
          <div class="ryztor-berberine__video-player" data-video="MAGNESIUM-SPANISH-4">
            <img src="{{ 'MAGNESIUM-SPANISH-4-poster.jpg' | asset_url }}" alt="{{ 'ryztor.magnesium.story.video_4_alt' | t | escape }}" loading="lazy" width="360" height="640">
            <button class="ryztor-berberine__video-play" aria-label="{{ 'ryztor.magnesium.story.play_video' | t | escape }}">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <video preload="metadata" playsinline controls width="360" height="640" poster="{{ 'MAGNESIUM-SPANISH-4-poster.jpg' | asset_url }}">
              <source src="{{ 'MAGNESIUM-SPANISH-4.webm' | asset_url }}" type="video/webm">
            </video>
          </div>
          <p class="ryztor-berberine__video-label">{{ 'ryztor.magnesium.story.video_4' | t }}</p>
        </div>
      </div>
    </div>
    {% endif %}

    <div class="ryztor-berberine__section ryztor-berberine__formula">
      <div class="ryztor-berberine__formula-copy">
        <p class="ryztor-berberine__eyebrow">{{ 'ryztor.magnesium.story.formula_eyebrow' | t }}</p>
        <h2>{{ 'ryztor.magnesium.story.formula_heading' | t }}</h2>
        <p>{{ 'ryztor.magnesium.story.formula_text' | t }}</p>
        <ul>
          <li><span>✓</span> {{ 'ryztor.magnesium.story.ingredient_1' | t }}</li>
          <li><span>✓</span> {{ 'ryztor.magnesium.story.ingredient_2' | t }}</li>
          <li><span>✓</span> {{ 'ryztor.magnesium.story.ingredient_3' | t }}</li>
          <li><span>✓</span> {{ 'ryztor.magnesium.story.ingredient_4' | t }}</li>
        </ul>
      </div>
      <div class="ryztor-berberine__formula-media">
        <img
          src="{{ 'ryztor-magnesium-clean-formula.webp' | asset_url }}"
          alt="{{ 'ryztor.magnesium.story.formula_alt' | t | escape }}"
          width="1254"
          height="1254"
          loading="lazy"
        >
      </div>
    </div>

    <div class="ryztor-berberine__section ryztor-berberine__comparison">
      <header class="ryztor-berberine__section-heading">
        <p class="ryztor-berberine__eyebrow">{{ 'ryztor.magnesium.story.compare_eyebrow' | t }}</p>
        <h2>{{ 'ryztor.magnesium.story.compare_heading' | t }}</h2>
        <p>{{ 'ryztor.magnesium.story.compare_text' | t }}</p>
      </header>

      <div class="ryztor-berberine__table" role="table" aria-label="{{ 'ryztor.magnesium.story.compare_label' | t | escape }}">
        <div class="ryztor-berberine__table-row ryztor-berberine__table-head" role="row">
          <div role="columnheader">{{ 'ryztor.magnesium.story.what_matters' | t }}</div>
          <div role="columnheader">RYZTOR</div>
          <div role="columnheader">{{ 'ryztor.magnesium.story.complicated' | t }}</div>
        </div>
        <div class="ryztor-berberine__table-row" role="row">
          <div role="rowheader">{{ 'ryztor.magnesium.story.focused' | t }}</div><div role="cell"><span>✓</span> {{ 'ryztor.magnesium.story.yes' | t }}</div><div role="cell">{{ 'ryztor.magnesium.story.crowded' | t }}</div>
        </div>
        <div class="ryztor-berberine__table-row" role="row">
          <div role="rowheader">{{ 'ryztor.magnesium.story.capsule_format' | t }}</div><div role="cell"><span>✓</span> {{ 'ryztor.magnesium.story.yes' | t }}</div><div role="cell">{{ 'ryztor.magnesium.story.mixing' | t }}</div>
        </div>
        <div class="ryztor-berberine__table-row" role="row">
          <div role="rowheader">{{ 'ryztor.magnesium.story.clear_routine' | t }}</div><div role="cell"><span>✓</span> {{ 'ryztor.magnesium.story.label_led' | t }}</div><div role="cell">{{ 'ryztor.magnesium.story.multiple_steps' | t }}</div>
        </div>
        <div class="ryztor-berberine__table-row" role="row">
          <div role="rowheader">{{ 'ryztor.magnesium.story.gentle_formula' | t }}</div><div role="cell"><span>✓</span> {{ 'ryztor.magnesium.story.glycinate' | t }}</div><div role="cell">{{ 'ryztor.magnesium.story.harsh' | t }}</div>
        </div>
      </div>
    </div>

    {% if review_count > 0 or request.design_mode %}
      <div class="ryztor-berberine__section ryztor-berberine__reviews">
        <header class="ryztor-berberine__section-heading">
          <p class="ryztor-berberine__eyebrow">{{ 'ryztor.magnesium.story.reviews_eyebrow' | t }}</p>
          <h2>{{ 'ryztor.magnesium.story.reviews_heading' | t }}</h2>
          <p>{{ 'ryztor.magnesium.story.reviews_intro' | t }}</p>
        </header>

        <div class="ryztor-berberine__review-grid">
          {% for block in section.blocks %}
            {% if block.type == 'review' %}
              {% if block.settings.quote != blank %}
                <article class="ryztor-berberine__review" {{ block.shopify_attributes }}>
                  <div class="ryztor-berberine__stars" aria-label="{{ 'ryztor.magnesium.story.stars_label' | t: rating: block.settings.rating | escape }}">
                    {% for index in (1..5) %}<span aria-hidden="true">{% if index <= block.settings.rating %}★{% else %}☆{% endif %}</span>{% endfor %}
                  </div>
                  {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                  <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
                  <footer>
                    <strong>{{ block.settings.author | escape }}</strong>
                    {% if block.settings.verified %}<span><i aria-hidden="true">✓</i> {{ 'ryztor.magnesium.story.verified_customer' | t }}</span>{% endif %}
                  </footer>
                </article>
              {% elsif request.design_mode %}
                <article class="ryztor-berberine__review ryztor-berberine__review--placeholder" {{ block.shopify_attributes }}>
                  <div class="ryztor-berberine__stars" aria-hidden="true">★★★★★</div>
                  <h3>Add a real customer review</h3>
                  <blockquote>This placeholder is visible only inside the theme editor.</blockquote>
                  <footer><strong>Customer name</strong></footer>
                </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="ryztor-berberine__cta">
      <div>
        <p>{{ 'ryztor.magnesium.story.cta_kicker' | t }}</p>
        <h2>{{ 'ryztor.magnesium.story.cta_heading' | t }}</h2>
      </div>
      <a href="#BuyButtons-ProductSubmitButton-add-to-cart">{{ 'ryztor.magnesium.story.cta_button' | t }}</a>
    </div>

    <p class="ryztor-berberine__disclaimer">
      {{ 'ryztor.magnesium.story.disclaimer' | t }}
    </p>
  </section>

{% endif %}

{% stylesheet %}
  @media screen and (min-width: 990px) {
    body:has(.ryztor-magnesium-section) .product-information.section--page-width {
      --page-content-width: 87.5rem;
    }
  }

    .ryztor-berberine {
      background: #fff;
      color: var(--rb-ink);
      overflow: hidden;
    }

    .ryztor-berberine__trust {
      width: min(100% - 32px, 1180px);
      margin: 20px auto 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border: 1px solid color-mix(in srgb, var(--rb-accent) 22%, transparent);
      border-radius: 18px;
      background: color-mix(in srgb, var(--rb-accent) 5%, white);
      overflow: hidden;
    }

    .ryztor-berberine__trust div {
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 12px 16px;
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
      text-align: center;
    }

    .ryztor-berberine__trust div + div { border-left: 1px solid color-mix(in srgb, var(--rb-accent) 16%, transparent); }
    .ryztor-berberine__trust span { color: var(--rb-accent); font-size: 1.05rem; }

    .ryztor-berberine__section {
      width: min(100% - 32px, 1180px);
      margin-inline: auto;
      padding-block: clamp(72px, 9vw, 124px);
    }

    .ryztor-berberine__eyebrow {
      margin: 0 0 15px;
      color: var(--rb-accent);
      font-size: .76rem;
      font-weight: 900;
      letter-spacing: .14em;
      line-height: 1.3;
      text-transform: uppercase;
    }

    .ryztor-berberine h2 {
      margin: 0;
      max-width: 850px;
      color: var(--rb-ink);
      font-size: clamp(2.25rem, 5.5vw, 5rem);
      font-weight: 900;
      letter-spacing: -.055em;
      line-height: .98;
      text-wrap: balance;
    }

    .ryztor-berberine__lead {
      max-width: 720px;
      margin-top: 24px;
      color: rgb(23 21 30 / 72%);
      font-size: clamp(1.04rem, 1.7vw, 1.28rem);
      line-height: 1.65;
    }

    .ryztor-berberine__intro > .ryztor-berberine__eyebrow,
    .ryztor-berberine__intro > h2,
    .ryztor-berberine__intro > .ryztor-berberine__lead {
      margin-inline: auto;
      text-align: center;
    }

    .ryztor-berberine__benefit-orbit {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 390px) minmax(0, 1fr);
      align-items: center;
      gap: clamp(38px, 6vw, 82px);
      margin-top: clamp(50px, 7vw, 82px);
    }

    .ryztor-berberine__benefit-column {
      min-height: 410px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 56px;
    }

    .ryztor-berberine__benefit-callout {
      position: relative;
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 12px;
      opacity: 0;
      transform: translateY(18px);
    }

    .ryztor-berberine__benefit-callout::after {
      position: absolute;
      top: 38px;
      width: clamp(28px, 4vw, 60px);
      border-top: 2px solid color-mix(in srgb, var(--rb-accent) 58%, white);
      content: '';
      opacity: .75;
    }

    .ryztor-berberine__benefit-column--left .ryztor-berberine__benefit-callout::after {
      right: -72px;
      transform: rotate(12deg);
      transform-origin: left;
    }

    .ryztor-berberine__benefit-column--right .ryztor-berberine__benefit-callout::after {
      left: -72px;
      transform: rotate(-12deg);
      transform-origin: right;
    }

    .ryztor-berberine__benefit-plus {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--rb-ink);
      color: #fff;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1;
      box-shadow: 0 7px 20px rgb(23 21 30 / 14%);
    }

    .ryztor-berberine__benefit-callout h3 {
      margin-bottom: 9px;
      font-size: clamp(1.05rem, 1.4vw, 1.28rem);
    }

    .ryztor-berberine__benefit-callout p {
      font-size: .88rem;
    }

    .ryztor-berberine__capsule {
      position: relative;
      z-index: 1;
      margin: 0;
      text-align: center;
    }

    .ryztor-berberine__capsule-glow {
      position: absolute;
      z-index: -1;
      inset: 12% 2% 20%;
      border-radius: 50%;
      background: radial-gradient(circle, color-mix(in srgb, var(--rb-accent) 22%, white), transparent 68%);
      filter: blur(10px);
      animation: ryztor-capsule-glow 3.6s ease-in-out infinite;
    }

    .ryztor-berberine__capsule img {
      width: 100%;
      height: auto;
      display: block;
      mix-blend-mode: multiply;
      animation: ryztor-capsule-float 4.6s ease-in-out infinite;
    }

    .ryztor-berberine__capsule figcaption {
      width: fit-content;
      max-width: 92%;
      margin: -20px auto 0;
      position: relative;
      z-index: 2;
      display: grid;
      gap: 3px;
      padding: 12px 18px;
      border: 1px solid color-mix(in srgb, var(--rb-accent) 22%, transparent);
      border-radius: 999px;
      background: rgb(255 255 255 / 92%);
      box-shadow: 0 12px 35px rgb(49 24 93 / 10%);
      backdrop-filter: blur(8px);
    }

    .ryztor-berberine__capsule figcaption strong {
      color: var(--rb-ink);
      font-size: .76rem;
    }

    .ryztor-berberine__capsule figcaption span {
      color: rgb(23 21 30 / 58%);
      font-size: .64rem;
    }

    .ryztor-berberine__benefit-orbit.is-visible .ryztor-berberine__benefit-callout {
      animation: ryztor-benefit-reveal .55s ease forwards;
    }

    .ryztor-berberine__benefit-orbit.is-visible .ryztor-berberine__benefit-column article:nth-child(2) {
      animation-delay: .15s;
    }

    @keyframes ryztor-benefit-reveal {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes ryztor-capsule-float {
      0%, 100% { transform: translateY(0) rotate(-1deg); }
      50% { transform: translateY(-10px) rotate(1deg); }
    }

    @keyframes ryztor-capsule-glow {
      0%, 100% { opacity: .62; transform: scale(.94); }
      50% { opacity: 1; transform: scale(1.04); }
    }

    .ryztor-berberine__review {
      border: 1px solid rgb(23 21 30 / 11%);
      border-radius: 22px;
      background: var(--rb-card);
      box-shadow: 0 16px 45px rgb(49 24 93 / 8%);
    }

    .ryztor-berberine h3 { margin: 0 0 10px; font-size: 1.15rem; font-weight: 850; letter-spacing: -.02em; line-height: 1.2; }
    .ryztor-berberine article p { margin: 0; color: rgb(23 21 30 / 68%); line-height: 1.6; }

    .ryztor-berberine__comparison,
    .ryztor-berberine__reviews,
    .ryztor-berberine__faq {
      width: 100%;
      max-width: none;
      padding-inline: max(16px, calc((100vw - 1180px) / 2));
    }

    .ryztor-berberine__reviews { background: var(--rb-soft); }
    .ryztor-berberine__section-heading { max-width: 760px; margin-bottom: 44px; }
    .ryztor-berberine__section-heading h2 { font-size: clamp(2.2rem, 4.8vw, 4.3rem); }
    .ryztor-berberine__section-heading > p:last-child { max-width: 660px; margin: 20px 0 0; color: rgb(23 21 30 / 68%); font-size: 1.06rem; line-height: 1.65; }

    .ryztor-berberine__formula { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(38px, 8vw, 110px); }
    .ryztor-berberine__formula-copy > p:not(.ryztor-berberine__eyebrow) { margin: 24px 0 0; color: rgb(23 21 30 / 70%); font-size: 1.08rem; line-height: 1.7; }
    .ryztor-berberine__formula ul { display: grid; gap: 15px; margin: 30px 0 0; padding: 0; list-style: none; }
    .ryztor-berberine__formula li { display: flex; gap: 12px; font-weight: 720; line-height: 1.45; }
    .ryztor-berberine__formula li span { color: var(--rb-accent); }
