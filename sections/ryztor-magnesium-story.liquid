      .ryztor-berberine__benefit-orbit.is-visible .ryztor-berberine__benefit-callout {
        animation: none;
      }
    }

  .ryztor-magnesium-section .ryztor-berberine__video-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 460px; }
  @media screen and (max-width: 749px) { .ryztor-magnesium-section .ryztor-berberine__video-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 340px; } }
{% endstylesheet %}

<script>
  document.querySelectorAll('[data-benefit-orbit]').forEach(function(orbit) {
    if (orbit.dataset.revealReady === 'true') return;
    orbit.dataset.revealReady = 'true';

    if (!('IntersectionObserver' in window)) {
      orbit.classList.add('is-visible');
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.18 });

    observer.observe(orbit);
  });

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.ryztor-berberine__video-play');
    var player = e.target.closest('.ryztor-berberine__video-player');
    if (!btn && !player) return;
    var container = player || btn.closest('.ryztor-berberine__video-player');
    var video = container.querySelector('video');
    var playBtn = container.querySelector('.ryztor-berberine__video-play');
    if (!video) return;
    if (video.paused) {
      container.classList.add('is-playing');
      playBtn.innerHTML = '<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
      video.play();
    } else {
      video.pause();
      container.classList.remove('is-playing');
      playBtn.innerHTML = '<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    }
  });
</script>

