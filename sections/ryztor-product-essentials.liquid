{% liquid
  assign product_name = product.title | downcase
  assign is_berberine = false
  if product_name contains 'berber'
    assign is_berberine = true
  endif
%}

{% if is_berberine %}
  <section
    class="ryztor-essentials"
    style="--essentials-accent: {{ section.settings.accent }}; --essentials-background: {{ section.settings.background }};"
  >
    <div class="ryztor-essentials__grid">
      <div class="ryztor-essentials__column">
        <header class="ryztor-essentials__heading">
          <p>PRODUCT INFORMATION</p>
          <h2>Know exactly what you're taking.</h2>
        </header>

        <div class="ryztor-essentials__accordions">
          <details name="product-information-{{ section.id }}" open>
            <summary>Description <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer rte">
              {{ section.settings.description }}
            </div>
          </details>

          <details name="product-information-{{ section.id }}">
            <summary>Ingredients <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Granular Berberine Hydrochloride Extract 97% (bark), Granular Berberine Hydrochloride Extract 8% (bark/root), cellulose (vegetable capsule), MCC (microcrystalline cellulose), L-Leucine, and olive oil.</p>
            </div>
          </details>

          <details name="product-information-{{ section.id }}">
            <summary>Directions <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Adults take two (2) capsules daily with 6–8 oz (177–236 ml) of water, or as directed by a healthcare professional. Do not exceed the recommended dose.</p>
            </div>
          </details>

          <details name="product-information-{{ section.id }}">
            <summary>Warning <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Pregnant or nursing mothers, children under 18, and individuals with known medical conditions or taking medication should consult a healthcare professional before using this or any dietary supplement.</p>
              <p>Keep out of reach of children. Do not use if the safety seal is damaged or missing. Store in a cool, dry place.</p>
            </div>
          </details>

          <details name="product-information-{{ section.id }}">
            <summary>Product details <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <dl class="ryztor-essentials__facts">
                <div><dt>Amount</dt><dd>60 capsules</dd></div>
                <div><dt>Supply</dt><dd>30 days when used as directed</dd></div>
                <div><dt>Suggested use</dt><dd>2 capsules daily</dd></div>
                <div><dt>Manufactured</dt><dd>USA</dd></div>
                <div><dt>Gross weight</dt><dd>2.56 oz / 0.16 lbs / 73 g</dd></div>
              </dl>
            </div>
          </details>

          <details name="product-information-{{ section.id }}">
            <summary>Dietary preferences <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <div class="ryztor-essentials__pills" aria-label="Dietary product attributes">
                <span>Gluten-free</span>
                <span>Vegetarian</span>
                <span>Allergen-free</span>
                <span>Non-GMO</span>
                <span>Vegan friendly</span>
              </div>
            </div>
          </details>
        </div>
      </div>

      <div class="ryztor-essentials__column">
        <header class="ryztor-essentials__heading">
          <p>QUESTIONS BEFORE ORDERING</p>
          <h2>Clear answers before you decide.</h2>
        </header>

        <div class="ryztor-essentials__accordions">
          <details name="ordering-questions-{{ section.id }}">
            <summary>Who is it for? <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>RYZTOR Berberine is designed for adults who want a simple way to add Berberine to a consistent daily wellness routine. It is a dietary supplement, not a substitute for balanced nutrition, regular activity, or professional medical care.</p>
            </div>
          </details>

          <details name="ordering-questions-{{ section.id }}">
            <summary>Who should speak with a healthcare professional first? <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Pregnant or nursing mothers, anyone under 18, people with a known medical condition, and anyone taking prescription medication should speak with a qualified healthcare professional before use.</p>
            </div>
          </details>

          <details name="ordering-questions-{{ section.id }}">
            <summary>When should I take it? <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Take two (2) capsules daily with 6–8 oz of water. Follow the product label and any guidance provided by your healthcare professional.</p>
            </div>
          </details>

          <details name="ordering-questions-{{ section.id }}">
            <summary>Can I use it with other supplements? <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Supplement routines are personal. If you use other supplements or take medication, ask a qualified healthcare professional to review the combination before adding Berberine.</p>
            </div>
          </details>

          <details name="ordering-questions-{{ section.id }}">
            <summary>Shipping &amp; returns <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Available shipping methods, estimated delivery times, and final costs are shown during checkout.</p>
              <div class="ryztor-essentials__links">
                {% if shop.shipping_policy != blank %}
                  <a href="{{ shop.shipping_policy.url }}">Read shipping policy</a>
                {% endif %}
                {% if shop.refund_policy != blank %}
                  <a href="{{ shop.refund_policy.url }}">Read refund policy</a>
                {% endif %}
              </div>
            </div>
          </details>

          <details name="ordering-questions-{{ section.id }}">
            <summary>Subscription &amp; cancellation <span aria-hidden="true">+</span></summary>
            <div class="ryztor-essentials__answer">
              <p>Subscribe &amp; Save options appear only when available for the selected product. Review the delivery frequency, renewal price, and cancellation terms before completing checkout.</p>
              {% if shop.subscription_policy != blank %}
                <div class="ryztor-essentials__links">
                  <a href="{{ shop.subscription_policy.url }}">Read subscription policy</a>
                </div>
              {% endif %}
            </div>
          </details>
        </div>
      </div>
    </div>

    <p class="ryztor-essentials__disclaimer">
      *These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.
    </p>
  </section>
{% endif %}

{% stylesheet %}
  .ryztor-essentials {
    padding: clamp(42px, 6vw, 78px) max(18px, calc((100vw - 1180px) / 2));
    background: var(--essentials-background);
    color: #17151e;
  }

  .ryztor-essentials__grid {
    width: 100%;
    max-width: 1180px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(34px, 6vw, 76px);
    margin: 0 auto;
  }

  .ryztor-essentials__column {
    min-width: 0;
  }

  .ryztor-essentials__heading {
    min-height: 116px;
    margin-bottom: 16px;
  }

  .ryztor-essentials__heading p {
    margin: 0 0 9px;
    color: var(--essentials-accent);
    font-size: .69rem;
    font-weight: 900;
    letter-spacing: .13em;
  }

  .ryztor-essentials__heading h2 {
    max-width: 470px;
    margin: 0;
    font-size: clamp(1.65rem, 2.7vw, 2.7rem);
    font-weight: 900;
    letter-spacing: -.045em;
    line-height: 1.04;
  }

  .ryztor-essentials__accordions {
    border-top: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-essentials__accordions details {
    border-bottom: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-essentials__accordions summary {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
    font-size: .88rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .ryztor-essentials__accordions summary::-webkit-details-marker {
    display: none;
  }

  .ryztor-essentials__accordions summary span {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--essentials-accent) 10%, white);
    color: var(--essentials-accent);
    font-size: 1.15rem;
    font-weight: 500;
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }

  .ryztor-essentials__accordions details[open] summary span {
    transform: rotate(45deg);
    background: var(--essentials-accent);
    color: #fff;
  }

  .ryztor-essentials__answer {
    padding: 0 42px 21px 0;
    color: rgb(23 21 30 / 68%);
    font-size: .84rem;
    line-height: 1.65;
  }

  .ryztor-essentials__answer p {
    margin: 0;
  }

  .ryztor-essentials__answer p + p {
    margin-top: 11px;
  }

  .ryztor-essentials__facts {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .ryztor-essentials__facts div {
    display: grid;
    grid-template-columns: minmax(120px, .8fr) 1.2fr;
    gap: 16px;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgb(23 21 30 / 10%);
  }

  .ryztor-essentials__facts div:last-child {
    padding-bottom: 0;
    border: 0;
  }

  .ryztor-essentials__facts dt {
    color: #17151e;
    font-weight: 850;
  }

  .ryztor-essentials__facts dd {
    margin: 0;
  }

  .ryztor-essentials__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .ryztor-essentials__pills span {
    padding: 7px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--essentials-accent) 8%, white);
    color: #17151e;
    font-size: .7rem;
    font-weight: 800;
  }

  .ryztor-essentials__links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 18px;
    margin-top: 12px;
  }

  .ryztor-essentials__links a {
    color: var(--essentials-accent);
    font-size: .75rem;
    font-weight: 850;
    text-underline-offset: 3px;
  }

  .ryztor-essentials__disclaimer {
    width: 100%;
    max-width: 1180px;
    margin: 24px auto 0;
    color: rgb(23 21 30 / 45%);
    font-size: .64rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ryztor-essentials {
      padding-block: 36px;
    }

    .ryztor-essentials__grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .ryztor-essentials__heading {
      min-height: 0;
      margin-bottom: 20px;
    }

    .ryztor-essentials__accordions summary {
      min-height: 60px;
      font-size: .84rem;
    }

    .ryztor-essentials__answer {
      padding-right: 14px;
    }

    .ryztor-essentials__facts div {
      grid-template-columns: 110px minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RYZTOR product essentials",
  "tag": "section",
  "class": "ryztor-product-essentials-section",
  "settings": [
    {
      "type": "richtext",
      "id": "description",
      "label": "Product description",
      "default": "<p>RYZTOR Berberine offers a convenient way to support everyday metabolic and cardiovascular wellness with just two capsules a day.* Its straightforward format is designed to make consistency easier without turning your routine into a complicated project.</p><p>For best results, use it as part of a balanced lifestyle that includes nutritious food, regular activity, and guidance from a qualified healthcare professional when appropriate.</p>"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#7652f5"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "RYZTOR product essentials"
    }
  ]
}
{% endschema %}
