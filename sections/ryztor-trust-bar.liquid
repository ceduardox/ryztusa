<div
  class="ryztor-trust-bar"
  style="--trust-bg: {{ section.settings.background }}; --trust-color: {{ section.settings.text_color }};"
  role="region"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="ryztor-trust-bar__track">
    {%- for copy in (1..2) -%}
      <div class="ryztor-trust-bar__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
        <span>{{ section.settings.message_1 | escape }}</span><i aria-hidden="true"></i>
        <span>{{ section.settings.message_2 | escape }}</span><i aria-hidden="true"></i>
        <span>{{ section.settings.message_3 | escape }}</span><i aria-hidden="true"></i>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ryztor-trust-bar {
    overflow: hidden;
    background: var(--trust-bg);
    color: var(--trust-color);
    border-block: 1px solid rgb(0 0 0 / 10%);
  }

  .ryztor-trust-bar__track {
    display: flex;
    width: max-content;
    animation: ryztor-marquee 24s linear infinite;
  }

  .ryztor-trust-bar__group {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 11px 14px;
    white-space: nowrap;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .ryztor-trust-bar__group i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  @keyframes ryztor-marquee {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ryztor-trust-bar__track { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RYZTOR trust bar",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "RYZTOR highlights"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "WELLNESS, MADE SIMPLE"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "THOUGHTFUL FORMULAS"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "BUILT FOR EVERYDAY ROUTINES"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#e4fe39"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "RYZTOR trust bar"
    }
  ]
}
{% endschema %}
