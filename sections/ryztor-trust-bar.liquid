<div
  class="ryztor-trust-bar"
  style="--trust-bg: {{ section.settings.background }}; --trust-color: {{ section.settings.text_color }}; --trust-speed: {{ section.settings.speed }}s;"
  role="region"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="ryztor-trust-bar__track">
    {%- for copy in (1..2) -%}
      <div class="ryztor-trust-bar__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
        <span>{{ section.settings.message_1 | escape }}</span><i aria-hidden="true"></i>
        <span>{{ section.settings.message_2 | escape }}</span><i aria-hidden="true"></i>
        <span>{{ section.settings.message_3 | escape }}</span><i aria-hidden="true"></i>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ryztor-trust-bar {
    overflow: hidden;
    background: var(--trust-bg);
    color: var(--trust-color);
    border-block: 1px solid rgb(0 0 0 / 10%);
  }

  .ryztor-trust-bar__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: ryztor-marquee var(--trust-speed) linear infinite;
  }

  .ryztor-trust-bar__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-around;
    min-width: 100vw;
    gap: clamp(24px, 3vw, 52px);
    padding: 9px clamp(14px, 2vw, 34px);
    white-space: nowrap;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .ryztor-trust-bar__group span {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
  }

  .ryztor-trust-bar__group span:nth-of-type(2) {
    padding: 7px 13px;
    border-radius: 999px;
    background: #6426ff;
    color: #fff;
  }

  .ryztor-trust-bar__group i {
    width: 8px;
    height: 8px;
    flex: 0 0 8px;
    background: currentColor;
    transform: rotate(45deg);
  }

  @keyframes ryztor-marquee {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ryztor-trust-bar__track { animation: none; }
  }

  @media screen and (max-width: 749px) {
    .ryztor-trust-bar__group {
      justify-content: flex-start;
      min-width: max-content;
      gap: 24px;
      padding-inline: 14px;
      font-size: .68rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RYZTOR trust bar",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "RYZTOR highlights"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "THREE FORMULAS. ZERO CONFUSION."
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "MORNINGS. TRAINING. NIGHTS."
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "BUILD YOUR BETTER ROUTINE."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation speed",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "s",
      "default": 24
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#e4fe39"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "RYZTOR trust bar"
    }
  ]
}
{% endschema %}
