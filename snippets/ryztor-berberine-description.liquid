{% liquid
  assign normalized_title = product_resource.title | downcase
  assign placement = placement | default: 'media'
  assign content = content | default: 'product'
%}

{% if normalized_title contains 'berber' %}
  <div class="ryztor-media-description ryztor-media-description--{{ placement }}">
    {% unless content == 'questions' %}
    <div class="ryztor-media-description__group">
      <p class="ryztor-media-description__eyebrow">{{ 'ryztor.berberine.details.eyebrow' | t }}</p>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.berberine.details.description_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.details.description_1' | t }}</p>
          <p>{{ 'ryztor.berberine.details.description_2' | t }}</p>

          <ul>
            <li>{{ 'ryztor.berberine.details.benefit_1' | t }}</li>
            <li>{{ 'ryztor.berberine.details.benefit_2' | t }}</li>
            <li>{{ 'ryztor.berberine.details.benefit_3' | t }}</li>
            <li>{{ 'ryztor.berberine.details.benefit_4' | t }}</li>
            <li>{{ 'ryztor.berberine.details.benefit_5' | t }}</li>
          </ul>

          <p>{{ 'ryztor.berberine.details.lifestyle_note' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.berberine.details.ingredients_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.details.ingredients' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.berberine.details.directions_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.details.directions' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.berberine.details.warning_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.details.warning_1' | t }}</p>
          <p>{{ 'ryztor.berberine.details.warning_2' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.berberine.details.product_details' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <dl class="ryztor-media-description__facts">
            <div><dt>{{ 'ryztor.berberine.details.amount' | t }}</dt><dd>60 {{ 'ryztor.berberine.commerce.capsules' | t | downcase }}</dd></div>
            <div><dt>{{ 'ryztor.berberine.details.supply' | t }}</dt><dd>{{ 'ryztor.berberine.details.supply_value' | t }}</dd></div>
            <div><dt>{{ 'ryztor.berberine.details.suggested_use' | t }}</dt><dd>{{ 'ryztor.berberine.details.use_value' | t }}</dd></div>
            <div><dt>{{ 'ryztor.berberine.details.manufactured' | t }}</dt><dd>USA</dd></div>
            <div><dt>{{ 'ryztor.berberine.details.gross_weight' | t }}</dt><dd>2.56 oz / 0.16 lbs / 73 g</dd></div>
          </dl>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.berberine.details.dietary_preferences' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <div class="ryztor-media-description__pills">
            <span>{{ 'ryztor.berberine.details.gluten_free' | t }}</span>
            <span>{{ 'ryztor.berberine.details.vegetarian' | t }}</span>
            <span>{{ 'ryztor.berberine.details.allergen_free' | t }}</span>
            <span>{{ 'ryztor.berberine.details.non_gmo' | t }}</span>
            <span>{{ 'ryztor.berberine.details.vegan' | t }}</span>
          </div>
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'product' %}
    <div class="ryztor-media-description__group ryztor-media-description__group--questions">
      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.support_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.support_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.body_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.body_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.for_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.for_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.directions_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.directions_text' | t }}</p>
        </div>
      </details>

      <div class="ryztor-question-gallery" data-question-gallery aria-label="{{ 'ryztor.berberine.questions.gallery_label' | t | escape }}">
        <div class="ryztor-question-gallery__track">
          {% assign question_gallery_images = 'ryztor-berberine-delivery-package.webp|RYZTOR Berberine held in an everyday setting@@ryztor-berberine-travel-handbag.webp|RYZTOR Berberine ready for a daily routine@@ryztor-berberine-daily-routine.webp|RYZTOR Berberine as part of an everyday routine@@ryztor-berberine-supplement-routine.webp|RYZTOR Berberine with daily supplements@@ryztor-berberine-wellness-books.webp|RYZTOR Berberine beside wellness books@@ryztor-berberine-bottle-closeup.webp|Close-up of RYZTOR Berberine@@ryztor-berberine-capsules-serving.webp|RYZTOR Berberine bottle and capsules@@ryztor-berberine-open-bottle-capsules.webp|Open RYZTOR Berberine bottle with capsules' | split: '@@' %}
          {% for image_data in question_gallery_images %}
            {% assign image_parts = image_data | split: '|' %}
            <button
              type="button"
              class="ryztor-question-gallery__photo"
              data-question-photo
              data-full-image="{{ image_parts[0] | asset_url }}"
              data-image-alt="{{ image_parts[1] | escape }}"
              aria-label="{{ 'ryztor.berberine.questions.enlarge' | t: description: image_parts[1] | escape }}"
            >
              <img src="{{ image_parts[0] | asset_url }}" alt="{{ image_parts[1] | escape }}" width="896" height="1200" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <dialog class="ryztor-question-gallery__dialog" data-question-dialog aria-label="{{ 'ryztor.berberine.questions.expanded_photo' | t | escape }}">
          <button type="button" class="ryztor-question-gallery__close" data-question-close aria-label="{{ 'ryztor.berberine.questions.close_photo' | t | escape }}">×</button>
          <img data-question-dialog-image src="{{ 'ryztor-berberine-delivery-package.webp' | asset_url }}" alt="RYZTOR Berberine in an everyday setting" width="896" height="1200">
        </dialog>
      </div>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.medications_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.medications_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.professional_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.professional_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.guarantee_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.guarantee_text' | t }}</p>
          {% if shop.refund_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.refund_policy.url }}">{{ 'ryztor.berberine.questions.refund_link' | t }}</a>
            </div>
          {% endif %}
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.shipping_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.shipping_text' | t }}</p>
          <div class="ryztor-media-description__links">
            {% if shop.shipping_policy != blank %}
              <a href="{{ shop.shipping_policy.url }}">{{ 'ryztor.berberine.questions.shipping_link' | t }}</a>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <a href="{{ shop.refund_policy.url }}">{{ 'ryztor.berberine.questions.refund_link' | t }}</a>
            {% endif %}
          </div>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.berberine.questions.subscription_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.berberine.questions.subscription_text' | t }}</p>
          {% if shop.subscription_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.subscription_policy.url }}">{{ 'ryztor.berberine.questions.subscription_link' | t }}</a>
            </div>
          {% endif %}
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'questions' %}
    <p class="ryztor-media-description__disclaimer">
      {{ 'ryztor.berberine.story.disclaimer' | t }}
    </p>
    {% endunless %}
  </div>
{% endif %}

{% stylesheet %}
  .product-information__media:has(.ryztor-media-description--media) media-gallery.sticky-content {
    position: static;
    top: auto;
    z-index: auto;
    margin-top: 0;
  }

  .ryztor-media-description {
    margin-top: 34px;
    color: rgb(23 21 30 / 76%);
    font-size: .84rem;
    line-height: 1.65;
  }

  .ryztor-media-description--mobile {
    display: none;
  }

  .ryztor-media-description--ordering {
    margin-top: 8px;
  }

  .ryztor-media-description__group {
    border-top: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-media-description__group--questions {
    margin-top: 0;
  }

  .ryztor-media-description__eyebrow {
    margin: 0;
    padding: 0 0 13px;
    border-bottom: 1px solid rgb(23 21 30 / 15%);
    color: #7652f5;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .13em;
  }

  .ryztor-media-description details {
    border-bottom: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-media-description summary {
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 13px 0;
    cursor: pointer;
    list-style: none;
    color: #17151e;
    font-size: .86rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .ryztor-media-description summary::-webkit-details-marker {
    display: none;
  }

  .ryztor-media-description summary span {
    flex: 0 0 auto;
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, #7652f5 10%, white);
    color: #7652f5;
    font-size: 1.12rem;
    font-weight: 500;
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }

  .ryztor-media-description details[open] summary span {
    transform: rotate(45deg);
    background: #7652f5;
    color: #fff;
  }

  .ryztor-media-description__answer {
    padding: 0 38px 20px 0;
  }

  .ryztor-media-description__answer p {
    margin: 0 0 13px;
  }

  .ryztor-media-description__answer p:last-child {
    margin-bottom: 0;
  }

  .ryztor-media-description__answer ul {
    display: grid;
    gap: 6px;
    margin: 4px 0 17px;
    padding-left: 18px;
  }

  .ryztor-media-description__facts {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .ryztor-media-description__facts div {
    display: grid;
    grid-template-columns: minmax(110px, .8fr) 1.2fr;
    gap: 14px;
    padding-bottom: 7px;
    border-bottom: 1px dashed rgb(23 21 30 / 10%);
  }

  .ryztor-media-description__facts div:last-child {
    padding-bottom: 0;
    border: 0;
  }

  .ryztor-media-description__facts dt {
    color: #17151e;
    font-weight: 850;
  }

  .ryztor-media-description__facts dd {
    margin: 0;
  }

  .ryztor-media-description__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .ryztor-media-description__pills span {
    padding: 7px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, #7652f5 8%, white);
    color: #17151e;
    font-size: .7rem;
    font-weight: 800;
  }

  .ryztor-media-description__links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 18px;
    margin-top: 12px;
  }

  .ryztor-media-description__links a {
    color: #7652f5;
    font-size: .75rem;
    font-weight: 850;
    text-underline-offset: 3px;
  }

  .ryztor-question-gallery {
    display: none;
    padding: 14px 0 16px;
    border-bottom: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-question-gallery__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .ryztor-question-gallery__photo {
    aspect-ratio: 3 / 4;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 10px;
    background: #eeeaf5;
    cursor: zoom-in;
  }

  .ryztor-question-gallery__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .3s ease;
  }

  .ryztor-question-gallery__photo:hover img { transform: scale(1.04); }
  .ryztor-question-gallery__photo:focus-visible { outline: 3px solid #7652f5; outline-offset: 2px; }
  .ryztor-question-gallery__photo[data-question-clone] { display: none; }

  .ryztor-question-gallery__dialog {
    width: min(90vw, 620px);
    max-width: none;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 20px;
    background: transparent;
    box-shadow: 0 28px 80px rgb(0 0 0 / 36%);
  }

  .ryztor-question-gallery__dialog::backdrop { background: rgb(13 10 20 / 80%); backdrop-filter: blur(7px); }
  .ryztor-question-gallery__dialog img { width: 100%; max-height: 86vh; display: block; border-radius: 20px; background: #fff; object-fit: contain; }
  .ryztor-question-gallery__close { position: absolute; z-index: 2; top: -13px; right: -13px; width: 38px; height: 38px; display: grid; place-items: center; border: 0; border-radius: 50%; background: #fff; color: #17151e; box-shadow: 0 7px 22px rgb(0 0 0 / 22%); cursor: pointer; font-size: 1.35rem; }

  .ryztor-media-description__disclaimer {
    margin: 22px 0 0;
    color: rgb(23 21 30 / 45%);
    font-size: .63rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ryztor-media-description--media {
      display: none;
    }

    .ryztor-media-description--mobile {
      display: block;
      margin: 26px 0 0;
    }

    .ryztor-media-description__group--questions {
      margin-top: 0;
    }

    .ryztor-media-description__answer {
      padding-right: 12px;
    }

    .ryztor-question-gallery {
      display: block;
      width: calc(100% + 4px);
      overflow: hidden;
    }

    .ryztor-question-gallery__track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 31%;
      grid-template-columns: none;
      gap: 8px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
    }

    .ryztor-question-gallery__track::-webkit-scrollbar { display: none; }
    .ryztor-question-gallery__photo { scroll-snap-align: start; border-radius: 9px; }
    .ryztor-question-gallery__photo[data-question-clone] { display: block; }
    .ryztor-question-gallery__close { top: 8px; right: 8px; }
  }
{% endstylesheet %}

<script>
  document.querySelectorAll('[data-question-gallery]').forEach((gallery) => {
    if (gallery.dataset.initialized === 'true') return;
    gallery.dataset.initialized = 'true';

    const dialog = gallery.querySelector('[data-question-dialog]');
    const dialogImage = gallery.querySelector('[data-question-dialog-image]');
    const closeButton = gallery.querySelector('[data-question-close]');
    const track = gallery.querySelector('.ryztor-question-gallery__track');
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let previousTime = 0;
    let paused = false;

    Array.from(track.children).forEach((photo) => {
      const clone = photo.cloneNode(true);
      clone.dataset.questionClone = '';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      track.appendChild(clone);
    });

    const animate = (time) => {
      if (mobileQuery.matches && !reduceMotion && !paused) {
        if (previousTime) {
          track.scrollLeft += ((time - previousTime) / 1000) * 24;
          const loopWidth = track.scrollWidth / 2;
          if (loopWidth && track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        previousTime = time;
      } else {
        previousTime = 0;
      }
      window.requestAnimationFrame(animate);
    };

    track.addEventListener('pointerdown', () => { paused = true; previousTime = 0; });
    track.addEventListener('pointerup', () => { paused = false; previousTime = 0; });
    track.addEventListener('pointercancel', () => { paused = false; previousTime = 0; });
    window.requestAnimationFrame(animate);

    gallery.querySelectorAll('[data-question-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        dialogImage.src = button.dataset.fullImage;
        dialogImage.alt = button.dataset.imageAlt;
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
