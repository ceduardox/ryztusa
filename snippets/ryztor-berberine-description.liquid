{% liquid
  assign normalized_title = product_resource.title | downcase
  assign placement = placement | default: 'media'
  assign content = content | default: 'product'
%}

{% if normalized_title contains 'berber' %}
  <div class="ryztor-media-description ryztor-media-description--{{ placement }}">
    {% unless content == 'questions' %}
    <div class="ryztor-media-description__group">
      <p class="ryztor-media-description__eyebrow">PRODUCT INFORMATION</p>

      <details name="ryztor-product-{{ placement }}">
        <summary>Description <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>
            Berberine capsules offer a convenient way to support your everyday well-being with just two capsules a day.
            This formula is designed to help maintain normal blood sugar levels, promote cardiovascular wellness, and
            support healthy weight management.*
          </p>

          <p>
            Each serving contains Granular Berberine Hydrochloride Extract, a plant-derived compound commonly used to
            support normal metabolic function and balance within the body.*
          </p>

          <p>
            Berberine is also recognized for its role in heart-conscious wellness. By supporting normal cholesterol
            levels and healthy heart function, it can complement a balanced daily lifestyle.*
          </p>

          <p>
            For people focused on weight management, Berberine supports the body's normal metabolism and can help you
            stay consistent with a broader wellness routine.*
          </p>

          <ul>
            <li>Supports normal blood sugar levels*</li>
            <li>Supports cardiovascular and heart wellness*</li>
            <li>Supports healthy metabolism and weight management*</li>
            <li>Two capsules daily · 60 capsules per bottle</li>
            <li>Gluten-free, non-GMO, vegetarian, and vegan friendly</li>
          </ul>

          <p>
            Supplements work best alongside balanced nutrition, regular exercise, hydration, and quality sleep.
            Individual experiences may vary.
          </p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Ingredients <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Granular Berberine Hydrochloride Extract 97% (bark), Granular Berberine Hydrochloride Extract 8% (bark/root), cellulose (vegetable capsule), MCC (microcrystalline cellulose), L-Leucine, and olive oil.</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Directions <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Adults take two (2) capsules daily with 6–8 oz (177–236 ml) of water, or as directed by a healthcare professional. Do not exceed the recommended dose.</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Warning <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Pregnant or nursing mothers, children under 18, and individuals with known medical conditions or taking medication should consult a healthcare professional before using this or any dietary supplement.</p>
          <p>Keep out of reach of children. Do not use if the safety seal is damaged or missing. Store in a cool, dry place.</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Product details <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <dl class="ryztor-media-description__facts">
            <div><dt>Amount</dt><dd>60 capsules</dd></div>
            <div><dt>Supply</dt><dd>30 days when used as directed</dd></div>
            <div><dt>Suggested use</dt><dd>2 capsules daily</dd></div>
            <div><dt>Manufactured</dt><dd>USA</dd></div>
            <div><dt>Gross weight</dt><dd>2.56 oz / 0.16 lbs / 73 g</dd></div>
          </dl>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Dietary preferences <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <div class="ryztor-media-description__pills">
            <span>Gluten-free</span>
            <span>Vegetarian</span>
            <span>Allergen-free</span>
            <span>Non-GMO</span>
            <span>Vegan friendly</span>
          </div>
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'product' %}
    <div class="ryztor-media-description__group ryztor-media-description__group--questions">
      <details name="ryztor-questions-{{ placement }}">
        <summary>What does Berberine help support? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Berberine helps support the way your cells process glucose and convert nutrients into everyday energy. It also helps maintain healthy blood sugar levels already within the normal range and supports cardiovascular wellness.*</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>How does it work in the body? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Berberine has been studied for its interaction with AMPK, an enzyme inside your cells involved in energy balance and glucose metabolism. Think of AMPK as one of the cellular signals that helps your body manage how it uses and stores energy.*</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Who is it for? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>RYZTOR Berberine is designed for adults who want simple daily support for healthy glucose metabolism, everyday energy, cardiovascular wellness, and weight-management goals. It complements balanced nutrition and regular activity; it does not replace professional medical care.</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>How do I take it and how long does one bottle last? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Take two (2) capsules daily with 6–8 oz of water. Each bottle contains 60 capsules, providing a 30-day supply when used as directed. Follow the product label and any guidance provided by your healthcare professional.</p>
        </div>
      </details>

      <div class="ryztor-question-gallery" data-question-gallery aria-label="Berberine in everyday settings">
        <div class="ryztor-question-gallery__track">
          {% assign question_gallery_images = 'ryztor-berberine-delivery-package.webp|RYZTOR Berberine held in an everyday setting@@ryztor-berberine-travel-handbag.webp|RYZTOR Berberine ready for a daily routine@@ryztor-berberine-daily-routine.webp|RYZTOR Berberine as part of an everyday routine@@ryztor-berberine-supplement-routine.webp|RYZTOR Berberine with daily supplements@@ryztor-berberine-wellness-books.webp|RYZTOR Berberine beside wellness books@@ryztor-berberine-bottle-closeup.webp|Close-up of RYZTOR Berberine@@ryztor-berberine-capsules-serving.webp|RYZTOR Berberine bottle and capsules@@ryztor-berberine-open-bottle-capsules.webp|Open RYZTOR Berberine bottle with capsules' | split: '@@' %}
          {% for image_data in question_gallery_images %}
            {% assign image_parts = image_data | split: '|' %}
            <button
              type="button"
              class="ryztor-question-gallery__photo"
              data-question-photo
              data-full-image="{{ image_parts[0] | asset_url }}"
              data-image-alt="{{ image_parts[1] | escape }}"
              aria-label="Enlarge {{ image_parts[1] | escape }}"
            >
              <img src="{{ image_parts[0] | asset_url }}" alt="{{ image_parts[1] | escape }}" width="896" height="1200" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <dialog class="ryztor-question-gallery__dialog" data-question-dialog aria-label="Expanded Berberine photo">
          <button type="button" class="ryztor-question-gallery__close" data-question-close aria-label="Close photo">×</button>
          <img data-question-dialog-image src="{{ 'ryztor-berberine-delivery-package.webp' | asset_url }}" alt="RYZTOR Berberine in an everyday setting" width="896" height="1200">
        </dialog>
      </div>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Can I take it with medications or other supplements? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Berberine may not be appropriate with every medication or supplement routine. If you take prescription medication—especially medication related to blood sugar—or use other supplements, ask a qualified healthcare professional to review the combination before use.</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Who should speak with a healthcare professional first? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Pregnant or nursing mothers, anyone under 18, people with a known medical condition, and anyone taking prescription medication should speak with a qualified healthcare professional before use.</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>What if it is not right for me? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Your purchase is covered by RYZTOR's 30-Day Money-Back Guarantee. Review the refund policy for eligibility, instructions, and any applicable conditions.</p>
          {% if shop.refund_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.refund_policy.url }}">Read refund policy</a>
            </div>
          {% endif %}
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Shipping &amp; returns <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Available shipping methods, estimated delivery times, and final costs are shown during checkout.</p>
          <div class="ryztor-media-description__links">
            {% if shop.shipping_policy != blank %}
              <a href="{{ shop.shipping_policy.url }}">Read shipping policy</a>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <a href="{{ shop.refund_policy.url }}">Read refund policy</a>
            {% endif %}
          </div>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Subscription &amp; cancellation <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Subscribe &amp; Save options appear only when available. Review the delivery frequency, renewal price, and cancellation terms before completing checkout.</p>
          {% if shop.subscription_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.subscription_policy.url }}">Read subscription policy</a>
            </div>
          {% endif %}
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'questions' %}
    <p class="ryztor-media-description__disclaimer">
      *These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.
    </p>
    {% endunless %}
  </div>
{% endif %}

{% stylesheet %}
  .product-information__media:has(.ryztor-media-description--media) media-gallery.sticky-content {
    position: static;
    top: auto;
    z-index: auto;
    margin-top: 0;
  }

  .ryztor-media-description {
    margin-top: 34px;
    color: rgb(23 21 30 / 76%);
    font-size: .84rem;
    line-height: 1.65;
  }

  .ryztor-media-description--mobile {
    display: none;
  }

  .ryztor-media-description--ordering {
    margin-top: 8px;
  }

  .ryztor-media-description__group {
    border-top: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-media-description__group--questions {
    margin-top: 0;
  }

  .ryztor-media-description__eyebrow {
    margin: 0;
    padding: 0 0 13px;
    border-bottom: 1px solid rgb(23 21 30 / 15%);
    color: #7652f5;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .13em;
  }

  .ryztor-media-description details {
    border-bottom: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-media-description summary {
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 13px 0;
    cursor: pointer;
    list-style: none;
    color: #17151e;
    font-size: .86rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .ryztor-media-description summary::-webkit-details-marker {
    display: none;
  }

  .ryztor-media-description summary span {
    flex: 0 0 auto;
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, #7652f5 10%, white);
    color: #7652f5;
    font-size: 1.12rem;
    font-weight: 500;
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }

  .ryztor-media-description details[open] summary span {
    transform: rotate(45deg);
    background: #7652f5;
    color: #fff;
  }

  .ryztor-media-description__answer {
    padding: 0 38px 20px 0;
  }

  .ryztor-media-description__answer p {
    margin: 0 0 13px;
  }

  .ryztor-media-description__answer p:last-child {
    margin-bottom: 0;
  }

  .ryztor-media-description__answer ul {
    display: grid;
    gap: 6px;
    margin: 4px 0 17px;
    padding-left: 18px;
  }

  .ryztor-media-description__facts {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .ryztor-media-description__facts div {
    display: grid;
    grid-template-columns: minmax(110px, .8fr) 1.2fr;
    gap: 14px;
    padding-bottom: 7px;
    border-bottom: 1px dashed rgb(23 21 30 / 10%);
  }

  .ryztor-media-description__facts div:last-child {
    padding-bottom: 0;
    border: 0;
  }

  .ryztor-media-description__facts dt {
    color: #17151e;
    font-weight: 850;
  }

  .ryztor-media-description__facts dd {
    margin: 0;
  }

  .ryztor-media-description__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .ryztor-media-description__pills span {
    padding: 7px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, #7652f5 8%, white);
    color: #17151e;
    font-size: .7rem;
    font-weight: 800;
  }

  .ryztor-media-description__links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 18px;
    margin-top: 12px;
  }

  .ryztor-media-description__links a {
    color: #7652f5;
    font-size: .75rem;
    font-weight: 850;
    text-underline-offset: 3px;
  }

  .ryztor-question-gallery {
    display: none;
    padding: 14px 0 16px;
    border-bottom: 1px solid rgb(23 21 30 / 15%);
  }

  .ryztor-question-gallery__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .ryztor-question-gallery__photo {
    aspect-ratio: 3 / 4;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 10px;
    background: #eeeaf5;
    cursor: zoom-in;
  }

  .ryztor-question-gallery__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .3s ease;
  }

  .ryztor-question-gallery__photo:hover img { transform: scale(1.04); }
  .ryztor-question-gallery__photo:focus-visible { outline: 3px solid #7652f5; outline-offset: 2px; }
  .ryztor-question-gallery__photo[data-question-clone] { display: none; }

  .ryztor-question-gallery__dialog {
    width: min(90vw, 620px);
    max-width: none;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 20px;
    background: transparent;
    box-shadow: 0 28px 80px rgb(0 0 0 / 36%);
  }

  .ryztor-question-gallery__dialog::backdrop { background: rgb(13 10 20 / 80%); backdrop-filter: blur(7px); }
  .ryztor-question-gallery__dialog img { width: 100%; max-height: 86vh; display: block; border-radius: 20px; background: #fff; object-fit: contain; }
  .ryztor-question-gallery__close { position: absolute; z-index: 2; top: -13px; right: -13px; width: 38px; height: 38px; display: grid; place-items: center; border: 0; border-radius: 50%; background: #fff; color: #17151e; box-shadow: 0 7px 22px rgb(0 0 0 / 22%); cursor: pointer; font-size: 1.35rem; }

  .ryztor-media-description__disclaimer {
    margin: 22px 0 0;
    color: rgb(23 21 30 / 45%);
    font-size: .63rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ryztor-media-description--media {
      display: none;
    }

    .ryztor-media-description--mobile {
      display: block;
      margin: 26px 0 0;
    }

    .ryztor-media-description__group--questions {
      margin-top: 0;
    }

    .ryztor-media-description__answer {
      padding-right: 12px;
    }

    .ryztor-question-gallery {
      display: block;
      width: calc(100% + 4px);
      overflow: hidden;
    }

    .ryztor-question-gallery__track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 31%;
      grid-template-columns: none;
      gap: 8px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
    }

    .ryztor-question-gallery__track::-webkit-scrollbar { display: none; }
    .ryztor-question-gallery__photo { scroll-snap-align: start; border-radius: 9px; }
    .ryztor-question-gallery__photo[data-question-clone] { display: block; }
    .ryztor-question-gallery__close { top: 8px; right: 8px; }
  }
{% endstylesheet %}

<script>
  document.querySelectorAll('[data-question-gallery]').forEach((gallery) => {
    if (gallery.dataset.initialized === 'true') return;
    gallery.dataset.initialized = 'true';

    const dialog = gallery.querySelector('[data-question-dialog]');
    const dialogImage = gallery.querySelector('[data-question-dialog-image]');
    const closeButton = gallery.querySelector('[data-question-close]');
    const track = gallery.querySelector('.ryztor-question-gallery__track');
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let previousTime = 0;
    let paused = false;

    Array.from(track.children).forEach((photo) => {
      const clone = photo.cloneNode(true);
      clone.dataset.questionClone = '';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      track.appendChild(clone);
    });

    const animate = (time) => {
      if (mobileQuery.matches && !reduceMotion && !paused) {
        if (previousTime) {
          track.scrollLeft += ((time - previousTime) / 1000) * 24;
          const loopWidth = track.scrollWidth / 2;
          if (loopWidth && track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        previousTime = time;
      } else {
        previousTime = 0;
      }
      window.requestAnimationFrame(animate);
    };

    track.addEventListener('pointerdown', () => { paused = true; previousTime = 0; });
    track.addEventListener('pointerup', () => { paused = false; previousTime = 0; });
    track.addEventListener('pointercancel', () => { paused = false; previousTime = 0; });
    window.requestAnimationFrame(animate);

    gallery.querySelectorAll('[data-question-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        dialogImage.src = button.dataset.fullImage;
        dialogImage.alt = button.dataset.imageAlt;
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
