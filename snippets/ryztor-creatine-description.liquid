{% liquid
  assign normalized_title = product_resource.title | downcase
  assign placement = placement | default: 'media'
  assign content = content | default: 'product'
%}

{% if normalized_title contains 'creatine' %}
  <div class="ryztor-media-description ryztor-media-description--{{ placement }}">
    {% unless content == 'questions' %}
      <div class="ryztor-media-description__group">
        <p class="ryztor-media-description__eyebrow">{{ 'ryztor.creatine.details.eyebrow' | t }}</p>

        <details name="ryztor-product-{{ placement }}">
          <summary>{{ 'ryztor.creatine.details.description_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{{ 'ryztor.creatine.details.description_1' | t }}</p>
            <p>{{ 'ryztor.creatine.details.description_2' | t }}</p>
            <ul>
              <li>{{ 'ryztor.creatine.details.benefit_1' | t }}</li>
              <li>{{ 'ryztor.creatine.details.benefit_2' | t }}</li>
              <li>{{ 'ryztor.creatine.details.benefit_3' | t }}</li>
              <li>{{ 'ryztor.creatine.details.benefit_4' | t }}</li>
            </ul>
          </div>
        </details>

        <details name="ryztor-product-{{ placement }}">
          <summary>{{ 'ryztor.creatine.details.ingredients_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{{ 'ryztor.creatine.details.ingredients' | t }}</p></div>
        </details>

        <details name="ryztor-product-{{ placement }}">
          <summary>{{ 'ryztor.creatine.details.directions_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{{ 'ryztor.creatine.details.directions' | t }}</p>
          </div>
        </details>

        <details name="ryztor-product-{{ placement }}">
          <summary>{{ 'ryztor.creatine.details.warning_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{{ 'ryztor.creatine.details.warning' | t }}</p>
          </div>
        </details>

        <details name="ryztor-product-{{ placement }}">
          <summary>{{ 'ryztor.creatine.details.product_details' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <dl class="ryztor-media-description__facts">
              <div><dt>{{ 'ryztor.creatine.details.formula' | t }}</dt><dd>{{ 'ryztor.creatine.details.formula_value' | t }}</dd></div>
              <div><dt>{{ 'ryztor.creatine.details.flavor' | t }}</dt><dd>{{ 'ryztor.creatine.details.flavor_value' | t }}</dd></div>
              <div><dt>{{ 'ryztor.creatine.details.amount' | t }}</dt><dd>250 g / 0.55 lb</dd></div>
              <div><dt>{{ 'ryztor.creatine.details.gross_weight' | t }}</dt><dd>308 g / 10.9 oz</dd></div>
              <div><dt>{{ 'ryztor.creatine.details.manufactured' | t }}</dt><dd>USA</dd></div>
            </dl>
          </div>
        </details>

        <details name="ryztor-product-{{ placement }}">
          <summary>{{ 'ryztor.creatine.details.dietary_preferences' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <div class="ryztor-media-description__pills"><span>{{ 'ryztor.creatine.details.flavor_value' | t }}</span><span>{{ 'ryztor.creatine.details.single_ingredient' | t }}</span></div>
          </div>
        </details>
      </div>
    {% endunless %}

    {% unless content == 'product' %}
      <div class="ryztor-media-description__group ryztor-media-description__group--questions">
        <details name="ryztor-questions-{{ placement }}">
          <summary>{{ 'ryztor.creatine.questions.for_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{{ 'ryztor.creatine.questions.for_text' | t }}</p></div>
        </details>
        <details name="ryztor-questions-{{ placement }}">
          <summary>{{ 'ryztor.creatine.questions.use_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{{ 'ryztor.creatine.questions.use_text' | t }}</p></div>
        </details>
        <details name="ryztor-questions-{{ placement }}">
          <summary>{{ 'ryztor.creatine.questions.flavor_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{{ 'ryztor.creatine.questions.flavor_text' | t }}</p></div>
        </details>
        <details name="ryztor-questions-{{ placement }}">
          <summary>{{ 'ryztor.creatine.questions.shipping_title' | t }} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{{ 'ryztor.creatine.questions.shipping_text' | t }}</p>
            <div class="ryztor-media-description__links">
              {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'ryztor.creatine.questions.shipping_link' | t }}</a>{% endif %}
              {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'ryztor.creatine.questions.refund_link' | t }}</a>{% endif %}
            </div>
          </div>
        </details>
      </div>
    {% endunless %}

    {% unless content == 'questions' %}
      <p class="ryztor-media-description__disclaimer">{{ 'ryztor.creatine.disclaimer' | t }}</p>
    {% endunless %}
  </div>
{% endif %}
