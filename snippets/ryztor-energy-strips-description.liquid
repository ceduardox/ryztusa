{% liquid
  assign normalized_title = product_resource.title | downcase
  assign placement = placement | default: 'media'
  assign content = content | default: 'product'
  assign is_spanish = false
  if request.locale.iso_code == 'es'
    assign is_spanish = true
  endif
%}

{% if normalized_title contains 'energy strip' %}
  <div class="ryztor-media-description ryztor-media-description--{{ placement }}">
    {% unless content == 'questions' %}
      <div class="ryztor-media-description__group">
        <p class="ryztor-media-description__eyebrow">{% if is_spanish %}ENERGÍA EN UN FORMATO PORTÁTIL{% else %}ENERGY IN A PORTABLE FORMAT{% endif %}</p>

        <details name="ryztor-energy-{{ placement }}">
          <summary>{% if is_spanish %}Descripción{% else %}Description{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Tiras orales con cafeína, L-teanina y vitamina B12, pensadas para adultos que buscan una opción práctica dentro de una rutina activa.{% else %}Oral strips with caffeine, L-theanine, and vitamin B12, created for adults who want a convenient option within an active routine.{% endif %}</p>
            <ul>
              <li>{% if is_spanish %}Formato delgado y fácil de llevar{% else %}Slim, easy-to-carry format{% endif %}</li>
              <li>{% if is_spanish %}Sabor arándano rojo{% else %}Cranberry flavor{% endif %}</li>
              <li>{% if is_spanish %}Una tira por uso{% else %}One strip per use{% endif %}</li>
              <li>{% if is_spanish %}30 tiras por paquete{% else %}30 strips per pack{% endif %}</li>
            </ul>
          </div>
        </details>

        <details name="ryztor-energy-{{ placement }}">
          <summary>{% if is_spanish %}Ingredientes{% else %}Ingredients{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>Pullulan, L-Theanine, Caffeine, Mannitol, Cellulose, Cranberry Flavor, Lecithin, Malic Acid, Pectin, Erythritol, Steviol Glycosides, Methylcobalamin.</p></div>
        </details>

        <details name="ryztor-energy-{{ placement }}">
          <summary>{% if is_spanish %}Modo de uso{% else %}How to use{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{% if is_spanish %}Coloca una tira sobre la lengua y deja que se disuelva. No consumas más de una tira al día. Sigue siempre las indicaciones de la etiqueta.{% else %}Place one strip on the tongue and allow it to dissolve. Do not consume more than one strip per day. Always follow the label directions.{% endif %}</p></div>
        </details>

        <details name="ryztor-energy-{{ placement }}">
          <summary>{% if is_spanish %}Advertencias{% else %}Warnings{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{% if is_spanish %}Contiene cafeína. Solo para adultos. No excedas la dosis recomendada. Si estás embarazada, en lactancia, tomas medicamentos o tienes una condición médica, consulta a un profesional de salud antes de usarlo. Mantén fuera del alcance de los niños.{% else %}Contains caffeine. For adults only. Do not exceed the recommended dose. If pregnant, nursing, taking medication, or managing a medical condition, consult a qualified health professional before use. Keep out of reach of children.{% endif %}</p></div>
        </details>

        <details name="ryztor-energy-{{ placement }}">
          <summary>{% if is_spanish %}Detalles del producto{% else %}Product details{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <dl class="ryztor-media-description__facts">
              <div><dt>{% if is_spanish %}Formato{% else %}Format{% endif %}</dt><dd>{% if is_spanish %}Tiras orales{% else %}Oral strips{% endif %}</dd></div>
              <div><dt>{% if is_spanish %}Sabor{% else %}Flavor{% endif %}</dt><dd>{% if is_spanish %}Arándano rojo{% else %}Cranberry{% endif %}</dd></div>
              <div><dt>{% if is_spanish %}Cantidad{% else %}Amount{% endif %}</dt><dd>30 oral strips</dd></div>
              <div><dt>{% if is_spanish %}Peso bruto{% else %}Gross weight{% endif %}</dt><dd>2.2 oz / 64 g</dd></div>
            </dl>
          </div>
        </details>
      </div>
    {% endunless %}

    {% unless content == 'product' %}
      <div class="ryztor-media-description__group ryztor-media-description__group--questions">
        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Qué ayuda a respaldar una rutina con cafeína?{% else %}What does a caffeine routine help support?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Una tira con cafeína y L-teanina puede ayudar a respaldar el estado de alerta y la concentración durante días activos, sesiones de estudio, trabajo o entrenamiento.*{% else %}A strip with caffeine and L-theanine can help support alertness and focus during active days, study sessions, work, or training.*{% endif %}</p>
          </div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Cómo actúa en el cuerpo?{% else %}How does it work in the body?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}La cafeína es un estimulante conocido por ayudar al estado de alerta, mientras la L-teanina es un aminoácido habitual en fórmulas de energía y concentración. La vitamina B12 contribuye al metabolismo energético normal y al funcionamiento normal del sistema nervioso.*{% else %}Caffeine is a well-known stimulant that helps support alertness, while L-theanine is a common amino acid in energy-and-focus formulas. Vitamin B12 contributes to normal energy-yielding metabolism and normal nervous-system function.*{% endif %}</p>
          </div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Para quién es?{% else %}Who is it for?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer"><p>{% if is_spanish %}Adultos que desean un formato portátil con cafeína para acompañar días activos, estudio, trabajo o entrenamiento.{% else %}Adults who want a portable caffeine format for active days, study, work, or training routines.{% endif %}</p></div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Cómo debo tomarlas y cuánto dura un paquete?{% else %}How should I take them and how long does a pack last?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Coloca una tira sobre la lengua y deja que se disuelva. La indicación es una tira al día y no debes exceder esa cantidad. Cada paquete contiene 30 tiras, lo que proporciona 30 días de uso cuando se toma según las indicaciones.{% else %}Place one strip on the tongue and allow it to dissolve. The direction is one strip per day and you should not exceed that amount. Each pack contains 30 strips, providing 30 days of use when taken as directed.{% endif %}</p>
          </div>
        </details>

        <div class="ryztor-question-gallery" data-question-gallery aria-label="{% if is_spanish %}Energy Strips en situaciones cotidianas{% else %}Energy Strips in everyday situations{% endif %}">
          <div class="ryztor-question-gallery__track">
            {% assign question_gallery_images = 'energy-strips-training.webp|Energy Strips for training@@energy-strips-study.webp|Energy Strips for study@@energy-strips-work.webp|Energy Strips for work@@energy-strips-on-the-go.webp|Energy Strips on the go' | split: '@@' %}
            {% for image_data in question_gallery_images %}
              {% assign image_parts = image_data | split: '|' %}
              <button
                type="button"
                class="ryztor-question-gallery__photo"
                data-question-photo
                data-full-image="{{ image_parts[0] | asset_url }}"
                data-image-alt="{{ image_parts[1] | escape }}"
                aria-label="{% if is_spanish %}Ampliar {% else %}Enlarge {% endif %}{{ image_parts[1] | escape }}"
              >
                <img src="{{ image_parts[0] | asset_url }}" alt="{{ image_parts[1] | escape }}" width="900" height="1125" loading="lazy">
              </button>
            {% endfor %}
          </div>

          <dialog class="ryztor-question-gallery__dialog" data-question-dialog aria-label="{% if is_spanish %}Foto ampliada del producto Energy Strips{% else %}Expanded Energy Strips product photo{% endif %}">
            <button type="button" class="ryztor-question-gallery__close" data-question-close aria-label="{% if is_spanish %}Cerrar foto{% else %}Close photo{% endif %}">×</button>
            <img data-question-dialog-image src="{{ 'energy-strips-training.webp' | asset_url }}" alt="Energy Strips for training" width="900" height="1125">
          </dialog>
        </div>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Puedo tomarlas con medicamentos u otros suplementos?{% else %}Can I take them with medication or other supplements?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}La cafeína puede no ser adecuada con todos los medicamentos, y algunas combinaciones deben espaciarse en el horario. Si tomas medicamentos con receta u otros estimulantes, pide a un profesional de salud calificado que revise la combinación antes de usarlo.{% else %}Caffeine may not be suitable with all medications, and some combinations should be spaced apart. If you take prescription medication or other stimulants, ask a qualified health professional to review the combination before use.{% endif %}</p>
          </div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Quién debe consultar primero con un profesional de salud?{% else %}Who should consult a health professional first?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Las mujeres embarazadas o en período de lactancia, los menores de 18 años, las personas sensibles a la cafeína y quienes toman medicamentos con receta deben consultar a un profesional de salud calificado antes de usarlo.{% else %}Pregnant or nursing women, people under 18, those sensitive to caffeine, and anyone taking prescription medication should consult a qualified health professional before use.{% endif %}</p>
          </div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}¿Qué sucede si no es adecuado para mí?{% else %}What if it's not right for me?{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Tu compra está cubierta por la garantía de devolución de dinero de 30 días de RYZTOR. Consulta la política de reembolso para conocer los requisitos, instrucciones y condiciones aplicables.{% else %}Your purchase is covered by RYZTOR's 30-day money-back guarantee. Please see the refund policy for applicable requirements, instructions, and conditions.{% endif %}</p>
            {% if shop.refund_policy != blank %}
              <div class="ryztor-media-description__links">
                <a href="{{ shop.refund_policy.url }}">{% if is_spanish %}Política de reembolso{% else %}Refund policy{% endif %}</a>
              </div>
            {% endif %}
          </div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}Envíos y devoluciones{% else %}Shipping & returns{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Los métodos de envío disponibles, los tiempos estimados de entrega y los costos finales se muestran durante el pago. Los pedidos superiores a $50 califican para envío gratis cuando corresponda.{% else %}Available shipping methods, estimated delivery times, and final costs are shown during checkout. Orders over $50 qualify for free shipping where applicable.{% endif %}</p>
            <div class="ryztor-media-description__links">
              {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">{% if is_spanish %}Política de envíos{% else %}Shipping policy{% endif %}</a>{% endif %}
              {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{% if is_spanish %}Política de reembolsos{% else %}Refund policy{% endif %}</a>{% endif %}
            </div>
          </div>
        </details>

        <details name="ryztor-energy-questions-{{ placement }}">
          <summary>{% if is_spanish %}Suscripción y cancelación{% else %}Subscription & cancellation{% endif %} <span aria-hidden="true">+</span></summary>
          <div class="ryztor-media-description__answer">
            <p>{% if is_spanish %}Las opciones de suscripción y ahorro aparecen únicamente cuando están disponibles. Revisa la frecuencia de entrega, el precio de renovación y las condiciones de cancelación antes de completar la compra.{% else %}Subscription and savings options appear only when available. Review the delivery frequency, renewal price, and cancellation terms before completing checkout.{% endif %}</p>
            {% if shop.subscription_policy != blank %}
              <div class="ryztor-media-description__links">
                <a href="{{ shop.subscription_policy.url }}">{% if is_spanish %}Política de suscripción{% else %}Subscription policy{% endif %}</a>
              </div>
            {% endif %}
          </div>
        </details>
      </div>
    {% endunless %}

    {% unless content == 'questions' %}
      <p class="ryztor-media-description__disclaimer">{% if is_spanish %}*Estas declaraciones no han sido evaluadas por la Administración de Alimentos y Medicamentos. Este producto no está destinado a diagnosticar, tratar, curar ni prevenir ninguna enfermedad.{% else %}*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.{% endif %}</p>
    {% endunless %}
  </div>
{% endif %}

<script>
  document.querySelectorAll('[data-question-gallery]').forEach((gallery) => {
    if (gallery.dataset.initialized === 'true') return;
    gallery.dataset.initialized = 'true';

    const dialog = gallery.querySelector('[data-question-dialog]');
    const dialogImage = gallery.querySelector('[data-question-dialog-image]');
    const closeButton = gallery.querySelector('[data-question-close]');
    const track = gallery.querySelector('.ryztor-question-gallery__track');
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let previousTime = 0;
    let paused = false;

    Array.from(track.children).forEach((photo) => {
      const clone = photo.cloneNode(true);
      clone.dataset.questionClone = '';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      track.appendChild(clone);
    });

    const animate = (time) => {
      if (mobileQuery.matches && !reduceMotion && !paused) {
        if (previousTime) {
          track.scrollLeft += ((time - previousTime) / 1000) * 24;
          const loopWidth = track.scrollWidth / 2;
          if (loopWidth && track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        previousTime = time;
      } else {
        previousTime = 0;
      }
      window.requestAnimationFrame(animate);
    };

    track.addEventListener('pointerdown', () => { paused = true; previousTime = 0; });
    track.addEventListener('pointerup', () => { paused = false; previousTime = 0; });
    track.addEventListener('pointercancel', () => { paused = false; previousTime = 0; });
    window.requestAnimationFrame(animate);

    gallery.querySelectorAll('[data-question-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        dialogImage.src = button.dataset.fullImage;
        dialogImage.alt = button.dataset.imageAlt;
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
