{% liquid
  assign normalized_title = product_resource.title | downcase
  assign placement = placement | default: 'media'
  assign content = content | default: 'product'
%}

{% if normalized_title contains 'magnesium' %}
  <div class="ryztor-media-description ryztor-media-description--{{ placement }}">
    {% unless content == 'questions' %}
    <div class="ryztor-media-description__group">
      <p class="ryztor-media-description__eyebrow">PRODUCT INFORMATION</p>

      <details name="ryztor-product-{{ placement }}">
        <summary>Description <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>
            Magnesium Glycinate Capsules deliver one of the most bioavailable forms of magnesium, helping your body maintain optimal levels of this essential mineral. Magnesium is vital for hundreds of biochemical reactions, including those that support nerve function, muscle health, and energy production.*
          </p>

          <p>
            This gentle, well-tolerated form is ideal for individuals seeking daily support for relaxation. Whether you're winding down after a long day or recovering from physical activity, magnesium glycinate helps support muscle relaxation and nervous system function.*
          </p>

          <p>
            Each serving provides 275 mg of elemental magnesium sourced from 2,500 mg of magnesium glycinate for optimal absorption and effectiveness. With no artificial additives and a clean, simple formula, it is perfect for supporting overall well-being, day and night.*
          </p>

          <ul>
            <li>Supports muscle relaxation and recovery*</li>
            <li>Supports nervous system health*</li>
            <li>Promotes healthy sleep patterns*</li>
            <li>Three capsules daily · 90 capsules per bottle</li>
            <li>Gentle formula, highly bioavailable</li>
          </ul>

          <p>
            Supplements work best alongside balanced nutrition, regular exercise, hydration, and quality sleep. Individual experiences may vary.
          </p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Ingredients <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Magnesium (from 2,500mg Magnesium Glycinate) 275mg, Hypromellose (capsule), Magnesium Stearate, Silicon Dioxide, Rice Flour.</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Directions <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Adults take three (3) capsules once daily with water, or as directed by a healthcare professional. Do not exceed the recommended dose.</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Warning <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Pregnant or nursing mothers, children under 18, and individuals with known medical conditions or taking medication should consult a healthcare professional before using this or any dietary supplement.</p>
          <p>Keep out of reach of children. Do not use if the safety seal is damaged or missing. Store in a cool, dry place.</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Product details <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <dl class="ryztor-media-description__facts">
            <div><dt>Amount</dt><dd>90 capsules</dd></div>
            <div><dt>Supply</dt><dd>30 days when used as directed</dd></div>
            <div><dt>Suggested use</dt><dd>3 capsules daily</dd></div>
            <div><dt>Manufactured</dt><dd>USA</dd></div>
            <div><dt>Gross weight</dt><dd>4 oz / 0.25 lb / 113 g</dd></div>
          </dl>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>Dietary preferences <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <div class="ryztor-media-description__pills">
            <span>Gluten-free</span>
            <span>Vegetarian</span>
            <span>Non-GMO</span>
          </div>
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'product' %}
    <div class="ryztor-media-description__group ryztor-media-description__group--questions">
      <details name="ryztor-questions-{{ placement }}">
        <summary>Who is it for? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>RYZTOR Magnesium Glycinate is designed for adults who want a simple way to support relaxation, muscle recovery, and healthy sleep as part of a consistent daily wellness routine. It is not a substitute for balanced nutrition, regular activity, or professional medical care.</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Who should speak with a healthcare professional first? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Pregnant or nursing mothers, anyone under 18, people with a known medical condition, and anyone taking prescription medication should speak with a qualified healthcare professional before use.</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>When should I take it? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Take three (3) capsules once daily with water. Many people prefer taking it in the evening to support relaxation and sleep. Follow the product label and any guidance provided by your healthcare professional.</p>
        </div>
      </details>

      <div class="ryztor-question-gallery" data-question-gallery aria-label="Magnesium Glycinate in everyday settings">
        <div class="ryztor-question-gallery__track">
          {% assign question_gallery_images = 'ryztor-magnesium-review-hand-desk.webp|RYZTOR Magnesium Glycinate held at home@@ryztor-magnesium-review-hand-home.webp|Bottle of RYZTOR Magnesium Glycinate in hand@@ryztor-magnesium-review-hand-outdoor.webp|RYZTOR Magnesium Glycinate held outdoors@@ryztor-magnesium-review-bottle-capsules.webp|Magnesium Glycinate bottle with capsules@@ryztor-magnesium-review-open-capsules.webp|Open Magnesium Glycinate bottle and capsules@@ryztor-magnesium-review-bed-capsules.webp|Magnesium Glycinate beside capsules@@ryztor-magnesium-review-open-bottle.webp|Open bottle of Magnesium Glycinate@@ryztor-magnesium-review-bedside.webp|Magnesium Glycinate as part of an evening routine@@ryztor-magnesium-review-nightstand.webp|Magnesium Glycinate on a nightstand@@ryztor-magnesium-review-desk.webp|Magnesium Glycinate on a desk@@ryztor-magnesium-review-kitchen.webp|Magnesium Glycinate on a kitchen counter@@ryztor-magnesium-review-outdoor-table.webp|Magnesium Glycinate on an outdoor table' | split: '@@' %}
          {% for image_data in question_gallery_images %}
            {% assign image_parts = image_data | split: '|' %}
            <button
              type="button"
              class="ryztor-question-gallery__photo"
              data-question-photo
              data-full-image="{{ image_parts[0] | asset_url }}"
              data-image-alt="{{ image_parts[1] | escape }}"
              aria-label="Enlarge {{ image_parts[1] | escape }}"
            >
              <img src="{{ image_parts[0] | asset_url }}" alt="{{ image_parts[1] | escape }}" width="896" height="1200" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <dialog class="ryztor-question-gallery__dialog" data-question-dialog aria-label="Expanded Magnesium product photo">
          <button type="button" class="ryztor-question-gallery__close" data-question-close aria-label="Close photo">×</button>
          <img data-question-dialog-image src="{{ 'ryztor-magnesium-review-hand-desk.webp' | asset_url }}" alt="RYZTOR Magnesium Glycinate held at home" width="896" height="1200">
        </dialog>
      </div>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Can I use it with other supplements? <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Supplement routines are personal. If you use other supplements or take medication, ask a qualified healthcare professional to review the combination before adding Magnesium Glycinate.</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Shipping &amp; returns <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Available shipping methods, estimated delivery times, and final costs are shown during checkout.</p>
          <div class="ryztor-media-description__links">
            {% if shop.shipping_policy != blank %}
              <a href="{{ shop.shipping_policy.url }}">Read shipping policy</a>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <a href="{{ shop.refund_policy.url }}">Read refund policy</a>
            {% endif %}
          </div>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>Subscription &amp; cancellation <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>Subscribe &amp; Save options appear only when available. Review the delivery frequency, renewal price, and cancellation terms before completing checkout.</p>
          {% if shop.subscription_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.subscription_policy.url }}">Read subscription policy</a>
            </div>
          {% endif %}
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'questions' %}
    <p class="ryztor-media-description__disclaimer">
      *These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.
    </p>
    {% endunless %}
  </div>
{% endif %}

<script>
  document.querySelectorAll('[data-question-gallery]').forEach((gallery) => {
    if (gallery.dataset.initialized === 'true') return;
    gallery.dataset.initialized = 'true';

    const dialog = gallery.querySelector('[data-question-dialog]');
    const dialogImage = gallery.querySelector('[data-question-dialog-image]');
    const closeButton = gallery.querySelector('[data-question-close]');
    const track = gallery.querySelector('.ryztor-question-gallery__track');
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let previousTime = 0;
    let paused = false;

    Array.from(track.children).forEach((photo) => {
      const clone = photo.cloneNode(true);
      clone.dataset.questionClone = '';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      track.appendChild(clone);
    });

    const animate = (time) => {
      if (mobileQuery.matches && !reduceMotion && !paused) {
        if (previousTime) {
          track.scrollLeft += ((time - previousTime) / 1000) * 24;
          const loopWidth = track.scrollWidth / 2;
          if (loopWidth && track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        previousTime = time;
      } else {
        previousTime = 0;
      }
      window.requestAnimationFrame(animate);
    };

    track.addEventListener('pointerdown', () => { paused = true; previousTime = 0; });
    track.addEventListener('pointerup', () => { paused = false; previousTime = 0; });
    track.addEventListener('pointercancel', () => { paused = false; previousTime = 0; });
    window.requestAnimationFrame(animate);

    gallery.querySelectorAll('[data-question-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        dialogImage.src = button.dataset.fullImage;
        dialogImage.alt = button.dataset.imageAlt;
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
