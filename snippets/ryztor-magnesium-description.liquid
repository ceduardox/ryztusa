{% liquid
  assign normalized_title = product_resource.title | downcase
  assign placement = placement | default: 'media'
  assign content = content | default: 'product'
%}

{% if normalized_title contains 'magnesium' %}
  <div class="ryztor-media-description ryztor-media-description--{{ placement }}">
    {% unless content == 'questions' %}
    <div class="ryztor-media-description__group">
      <p class="ryztor-media-description__eyebrow">{{ 'ryztor.magnesium.details.eyebrow' | t }}</p>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.details.description_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.details.description_1' | t }}</p>
          <p>{{ 'ryztor.magnesium.details.description_2' | t }}</p>
          <p>{{ 'ryztor.magnesium.details.description_3' | t }}</p>

          <ul>
            <li>{{ 'ryztor.magnesium.details.benefit_1' | t }}</li>
            <li>{{ 'ryztor.magnesium.details.benefit_2' | t }}</li>
            <li>{{ 'ryztor.magnesium.details.benefit_3' | t }}</li>
            <li>{{ 'ryztor.magnesium.details.benefit_4' | t }}</li>
            <li>{{ 'ryztor.magnesium.details.benefit_5' | t }}</li>
          </ul>

          <p>{{ 'ryztor.magnesium.details.lifestyle_note' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.details.ingredients_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.details.ingredients' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.details.directions_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.details.directions' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.details.warning_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.details.warning_1' | t }}</p>
          <p>{{ 'ryztor.magnesium.details.warning_2' | t }}</p>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.details.product_details' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <dl class="ryztor-media-description__facts">
            <div><dt>{{ 'ryztor.magnesium.details.amount' | t }}</dt><dd>90 capsules</dd></div>
            <div><dt>{{ 'ryztor.magnesium.details.supply' | t }}</dt><dd>{{ 'ryztor.magnesium.details.supply_value' | t }}</dd></div>
            <div><dt>{{ 'ryztor.magnesium.details.suggested_use' | t }}</dt><dd>{{ 'ryztor.magnesium.details.use_value' | t }}</dd></div>
            <div><dt>{{ 'ryztor.magnesium.details.manufactured' | t }}</dt><dd>USA</dd></div>
            <div><dt>{{ 'ryztor.magnesium.details.gross_weight' | t }}</dt><dd>4 oz / 0.25 lb / 113 g</dd></div>
          </dl>
        </div>
      </details>

      <details name="ryztor-product-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.details.dietary_preferences' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <div class="ryztor-media-description__pills">
            <span>{{ 'ryztor.magnesium.details.gluten_free' | t }}</span>
            <span>{{ 'ryztor.magnesium.details.vegetarian' | t }}</span>
            <span>{{ 'ryztor.magnesium.details.non_gmo' | t }}</span>
          </div>
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'product' %}
    <div class="ryztor-media-description__group ryztor-media-description__group--questions">
      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.support_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.support_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.body_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.body_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.for_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.for_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.directions_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.directions_text' | t }}</p>
        </div>
      </details>

      <div class="ryztor-question-gallery" data-question-gallery aria-label="{{ 'ryztor.magnesium.questions.gallery_label' | t | escape }}">
        <div class="ryztor-question-gallery__track">
          {% assign question_gallery_images = 'ryztor-magnesium-review-hand-desk.webp|RYZTOR Magnesium Glycinate held at home@@ryztor-magnesium-review-hand-home.webp|Bottle of RYZTOR Magnesium Glycinate in hand@@ryztor-magnesium-review-hand-outdoor.webp|RYZTOR Magnesium Glycinate held outdoors@@ryztor-magnesium-review-bottle-capsules.webp|Magnesium Glycinate bottle with capsules@@ryztor-magnesium-review-open-capsules.webp|Open Magnesium Glycinate bottle and capsules@@ryztor-magnesium-review-bed-capsules.webp|Magnesium Glycinate beside capsules@@ryztor-magnesium-review-open-bottle.webp|Open bottle of Magnesium Glycinate@@ryztor-magnesium-review-bedside.webp|Magnesium Glycinate as part of an evening routine@@ryztor-magnesium-review-nightstand.webp|Magnesium Glycinate on a nightstand@@ryztor-magnesium-review-desk.webp|Magnesium Glycinate on a desk@@ryztor-magnesium-review-kitchen.webp|Magnesium Glycinate on a kitchen counter@@ryztor-magnesium-review-outdoor-table.webp|Magnesium Glycinate on an outdoor table' | split: '@@' %}
          {% for image_data in question_gallery_images %}
            {% assign image_parts = image_data | split: '|' %}
            <button
              type="button"
              class="ryztor-question-gallery__photo"
              data-question-photo
              data-full-image="{{ image_parts[0] | asset_url }}"
              data-image-alt="{{ image_parts[1] | escape }}"
              aria-label="{{ 'ryztor.magnesium.questions.enlarge' | t: description: image_parts[1] | escape }}"
            >
              <img src="{{ image_parts[0] | asset_url }}" alt="{{ image_parts[1] | escape }}" width="896" height="1200" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <dialog class="ryztor-question-gallery__dialog" data-question-dialog aria-label="{{ 'ryztor.magnesium.questions.expanded_photo' | t | escape }}">
          <button type="button" class="ryztor-question-gallery__close" data-question-close aria-label="{{ 'ryztor.magnesium.questions.close_photo' | t | escape }}">×</button>
          <img data-question-dialog-image src="{{ 'ryztor-magnesium-review-hand-desk.webp' | asset_url }}" alt="RYZTOR Magnesium Glycinate held at home" width="896" height="1200">
        </dialog>
      </div>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.medications_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.medications_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.professional_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.professional_text' | t }}</p>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.guarantee_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.guarantee_text' | t }}</p>
          {% if shop.refund_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.refund_policy.url }}">{{ 'ryztor.magnesium.questions.refund_link' | t }}</a>
            </div>
          {% endif %}
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.shipping_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.shipping_text' | t }}</p>
          <div class="ryztor-media-description__links">
            {% if shop.shipping_policy != blank %}
              <a href="{{ shop.shipping_policy.url }}">{{ 'ryztor.magnesium.questions.shipping_link' | t }}</a>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <a href="{{ shop.refund_policy.url }}">{{ 'ryztor.magnesium.questions.refund_link' | t }}</a>
            {% endif %}
          </div>
        </div>
      </details>

      <details name="ryztor-questions-{{ placement }}">
        <summary>{{ 'ryztor.magnesium.questions.subscription_title' | t }} <span aria-hidden="true">+</span></summary>
        <div class="ryztor-media-description__answer">
          <p>{{ 'ryztor.magnesium.questions.subscription_text' | t }}</p>
          {% if shop.subscription_policy != blank %}
            <div class="ryztor-media-description__links">
              <a href="{{ shop.subscription_policy.url }}">{{ 'ryztor.magnesium.questions.subscription_link' | t }}</a>
            </div>
          {% endif %}
        </div>
      </details>
    </div>
    {% endunless %}

    {% unless content == 'questions' %}
    <p class="ryztor-media-description__disclaimer">
      {{ 'ryztor.magnesium.disclaimer' | t }}
    </p>
    {% endunless %}
  </div>
{% endif %}

<script>
  document.querySelectorAll('[data-question-gallery]').forEach((gallery) => {
    if (gallery.dataset.initialized === 'true') return;
    gallery.dataset.initialized = 'true';

    const dialog = gallery.querySelector('[data-question-dialog]');
    const dialogImage = gallery.querySelector('[data-question-dialog-image]');
    const closeButton = gallery.querySelector('[data-question-close]');
    const track = gallery.querySelector('.ryztor-question-gallery__track');
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let previousTime = 0;
    let paused = false;

    Array.from(track.children).forEach((photo) => {
      const clone = photo.cloneNode(true);
      clone.dataset.questionClone = '';
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      track.appendChild(clone);
    });

    const animate = (time) => {
      if (mobileQuery.matches && !reduceMotion && !paused) {
        if (previousTime) {
          track.scrollLeft += ((time - previousTime) / 1000) * 24;
          const loopWidth = track.scrollWidth / 2;
          if (loopWidth && track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        previousTime = time;
      } else {
        previousTime = 0;
      }
      window.requestAnimationFrame(animate);
    };

    track.addEventListener('pointerdown', () => { paused = true; previousTime = 0; });
    track.addEventListener('pointerup', () => { paused = false; previousTime = 0; });
    track.addEventListener('pointercancel', () => { paused = false; previousTime = 0; });
    window.requestAnimationFrame(animate);

    gallery.querySelectorAll('[data-question-photo]').forEach((button) => {
      button.addEventListener('click', () => {
        dialogImage.src = button.dataset.fullImage;
        dialogImage.alt = button.dataset.imageAlt;
        dialog.showModal();
      });
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
