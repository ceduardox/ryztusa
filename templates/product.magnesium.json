            "magnesium_rating": {
              "type": "custom-liquid",
              "name": "Magnesium rating",
              "settings": {
                "custom_liquid": "{% assign product_name = closest.product.title | downcase %}{% if product_name contains 'magnesium' %}<a class=\"ryztor-rating\" href=\"#ryztor-reviews\" style=\"color:inherit;text-decoration:none\"><span class=\"ryztor-rating__stars\" aria-hidden=\"true\">★★★★★</span><span class=\"ryztor-rating__score\">4.8</span><span class=\"ryztor-rating__count\">(94 reviews)</span></a>{% endif %}",
