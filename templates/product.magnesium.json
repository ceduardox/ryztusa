            "magnesium_savings": {
              "type": "custom-liquid",
              "name": "Magnesium savings",
              "settings": {
                "custom_liquid": "{% assign product_name = closest.product.title | downcase %}{% if product_name contains 'magnesium' %}{% assign p = closest.product.selected_or_first_available_variant %}{% if p.compare_at_price > p.price %}{% assign save = p.compare_at_price | minus: p.price %}{% assign save_pct = save | times: 100 | divided_by: p.compare_at_price %}<div class=\"ryztor-savings\">You save <strong>{{ save | money }}</strong> ({{ save_pct }}% off)</div>{% endif %}{% endif %}",
                "padding-block-start": 2,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "magnesium_summary": {
              "type": "custom-liquid",
              "name": "Magnesium quick summary",
              "settings": {
                "custom_liquid": "{% assign product_name = closest.product.title | downcase %}{% if product_name contains 'magnesium' %}<div class=\"ryztor-product-summary\"><p><strong>Relaxation & recovery that fits your night.*</strong> Three capsules daily to help support muscle relaxation, nervous system health, and restful sleep—with a highly bioavailable, gentle-on-the-stomach formula.</p><div class=\"ryztor-product-summary__benefits\"><div><b>90</b><span>Capsules</span></div><div><b>3×</b><span>Daily use</span></div><div><b>USA</b><span>Manufactured</span></div></div></div>{% endif %}"
              },
              "blocks": {}
            },
